    "clean": "rm -rf coverage reports"
  },
  "devDependencies": {
    "@rp/contracts": "workspace:*",
    "@rp/ordering": "workspace:*",
    "@rp/relay": "workspace:*",
    "@rp/test-postgres": "workspace:*",
    "@rp/totp": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
