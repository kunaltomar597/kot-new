{
  "name": "@rp/dast",
  "version": "0.1.0",
  "private": true,
  "description": "DAST (P8-03c1, SEC-017): OWASP ZAP scans of the QR site, the relay, the Control Plane and the local server as they run for real, with every finding triaged.",
