{
  "name": "@rp/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned API and domain-event contracts (Zod schemas) shared by every app (INT-001, INT-002).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rp/domain": "workspace:*",
    "zod": "^4.6.5"
  }
}
