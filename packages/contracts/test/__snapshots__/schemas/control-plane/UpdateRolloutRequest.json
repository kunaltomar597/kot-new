{
  "input": {
    "type": "object",
    "properties": {
      "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
      "state": { "type": "string", "enum": ["ACTIVE", "PAUSED", "HALTED"] },
      "cohort": {
        "default": [],
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "reason": { "type": "string", "minLength": 3, "maxLength": 200 }
    },
    "required": ["percent", "state", "reason"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
      "state": { "type": "string", "enum": ["ACTIVE", "PAUSED", "HALTED"] },
      "cohort": {
        "default": [],
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "reason": { "type": "string", "minLength": 3, "maxLength": 200 }
    },
    "required": ["percent", "state", "cohort", "reason"],
    "additionalProperties": false
  }
}
