{
  "input": {
    "type": "object",
    "properties": {
      "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
      "role": { "type": "string", "enum": ["MANAGER", "CASHIER", "WAITER", "KITCHEN"] },
      "customRoleId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          { "type": "null" }
        ]
      },
      "pin": { "type": "string", "pattern": "^\\d{4,8}$" },
      "phone": {
        "anyOf": [{ "type": "string", "pattern": "^\\+?\\d[\\d -]{4,18}\\d$" }, { "type": "null" }]
      },
      "email": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          { "type": "null" }
        ]
      }
    },
    "required": ["displayName", "role", "pin"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
      "role": { "type": "string", "enum": ["MANAGER", "CASHIER", "WAITER", "KITCHEN"] },
      "customRoleId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          { "type": "null" }
        ]
      },
      "pin": { "type": "string", "pattern": "^\\d{4,8}$" },
      "phone": {
        "anyOf": [{ "type": "string", "pattern": "^\\+?\\d[\\d -]{4,18}\\d$" }, { "type": "null" }]
      },
      "email": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          { "type": "null" }
        ]
      }
    },
    "required": ["displayName", "role", "pin"],
    "additionalProperties": false
  }
}
