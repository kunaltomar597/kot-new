{
  "input": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "displayName": { "type": "string" },
      "legalName": { "type": ["string", "null"] },
      "address": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "line1": { "type": "string", "minLength": 1, "maxLength": 120 },
              "line2": { "type": "string", "minLength": 1, "maxLength": 120 },
              "city": { "type": "string", "minLength": 1, "maxLength": 60 },
              "pincode": { "type": "string", "pattern": "^[1-9]\\d{5}$" }
            },
            "required": ["line1", "city", "pincode"],
            "additionalProperties": false
          },
          { "type": "null" }
        ]
      },
      "stateCode": { "type": ["string", "null"] },
      "stateName": { "type": ["string", "null"] },
      "gstin": { "type": ["string", "null"] },
      "fssaiNumber": { "type": ["string", "null"] },
      "contact": {
        "type": "object",
        "properties": {
          "phone": {
            "anyOf": [
              { "type": "string", "pattern": "^\\+?\\d[\\d -]{4,18}\\d$" },
              { "type": "null" }
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["phone", "email"],
        "additionalProperties": false
      },
      "businessHours": {
        "maxItems": 28,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "day": { "type": "string", "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] },
            "start": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "end": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
          },
          "required": ["day", "start", "end"],
          "additionalProperties": false
        }
      },
      "logoPhotoId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          { "type": "null" }
        ]
      },
      "timeZone": { "type": "string" },
      "businessDayCutoff": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
      }
    },
    "required": [
      "id",
      "displayName",
      "legalName",
      "address",
      "stateCode",
      "stateName",
      "gstin",
      "fssaiNumber",
      "contact",
      "businessHours",
      "logoPhotoId",
      "timeZone",
      "businessDayCutoff",
      "updatedAt"
    ]
  },
