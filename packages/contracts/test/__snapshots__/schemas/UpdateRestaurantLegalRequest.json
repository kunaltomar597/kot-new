{
  "input": {
    "type": "object",
    "properties": {
      "legalName": { "type": "string", "minLength": 1, "maxLength": 120 },
      "address": {
        "type": "object",
        "properties": {
          "line1": { "type": "string", "minLength": 1, "maxLength": 120 },
          "line2": { "type": "string", "minLength": 1, "maxLength": 120 },
          "city": { "type": "string", "minLength": 1, "maxLength": 60 },
          "pincode": { "type": "string", "pattern": "^[1-9]\\d{5}$" }
        },
        "required": ["line1", "city", "pincode"],
        "additionalProperties": false
      },
      "stateCode": { "type": "string", "pattern": "^\\d{2}$" },
      "gstin": {
        "anyOf": [
          { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$" },
          { "type": "null" }
        ]
      },
      "fssaiNumber": {
        "anyOf": [{ "type": "string", "pattern": "^\\d{14}$" }, { "type": "null" }]
      },
      "reason": { "type": "string", "minLength": 3, "maxLength": 200 }
    },
