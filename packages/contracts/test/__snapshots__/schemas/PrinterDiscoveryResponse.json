{
  "input": {
    "type": "object",
    "properties": {
      "networks": { "type": "array", "items": { "type": "string" } },
      "printers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "printerId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                { "type": "null" }
              ]
            },
            "printerName": { "type": ["string", "null"] }
          },
          "required": ["host", "port", "printerId", "printerName"]
        }
      }
    },
    "required": ["networks", "printers"]
  },
  "output": {
    "type": "object",
    "properties": {
      "networks": { "type": "array", "items": { "type": "string" } },
      "printers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "printerId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                { "type": "null" }
              ]
            },
            "printerName": { "type": ["string", "null"] }
          },
          "required": ["host", "port", "printerId", "printerName"],
          "additionalProperties": false
        }
      }
    },
    "required": ["networks", "printers"],
    "additionalProperties": false
  }
}
