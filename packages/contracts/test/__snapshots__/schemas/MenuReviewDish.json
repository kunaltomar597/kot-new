{
  "input": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 80 },
      "description": { "anyOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
      "price": {
        "anyOf": [
          { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          { "type": "null" }
        ]
      },
      "variants": {
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 40 },
            "price": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["name", "price"],
          "additionalProperties": false
        }
      },
      "foodType": { "type": "string", "enum": ["VEG", "NON_VEG", "EGG"] },
      "spiceLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
      "tags": {
        "maxItems": 10,
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 30 }
      },
      "taxGroupId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "stationId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "checked": { "type": "boolean" }
    },
    "required": [
      "name",
      "description",
      "price",
      "variants",
      "foodType",
      "spiceLevel",
      "tags",
      "taxGroupId",
      "stationId",
      "checked"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 80 },
      "description": { "anyOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
      "price": {
        "anyOf": [
          { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          { "type": "null" }
        ]
      },
      "variants": {
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 40 },
            "price": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["name", "price"],
          "additionalProperties": false
        }
      },
      "foodType": { "type": "string", "enum": ["VEG", "NON_VEG", "EGG"] },
      "spiceLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
      "tags": {
        "maxItems": 10,
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 30 }
      },
      "taxGroupId": {
