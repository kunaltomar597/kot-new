{
  "input": {
    "type": "object",
    "properties": {
      "cart": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ]
      },
      "vegOnly": {
        "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["true", "false"] }]
      },
      "limit": { "default": 6, "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "cart": {},
      "vegOnly": { "default": false, "anyOf": [{ "type": "boolean" }, {}] },
      "limit": { "default": 6, "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "required": ["cart", "vegOnly", "limit"],
    "additionalProperties": false
  }
}
