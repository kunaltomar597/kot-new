{
  "input": {
    "type": "object",
    "properties": {
      "photoId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "width": { "type": "number" }
    },
    "required": ["photoId", "width"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "photoId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "width": {
        "anyOf": [
          { "type": "number", "const": 160 },
          { "type": "number", "const": 480 },
          { "type": "number", "const": 960 }
        ]
      }
    },
    "required": ["photoId", "width"],
    "additionalProperties": false
  }
}
