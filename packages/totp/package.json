{
  "name": "@rp/totp",
  "version": "0.1.0",
  "private": true,
  "description": "Time-based one-time passwords (RFC 6238) for the Owner's second factor on the restaurant PC (AUTH-006) and vendor staff's MFA in the Control Plane (VCP-001).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  }
}
