{
  "name": "@rp/mobile-native",
  "version": "0.1.0",
  "private": true,
  "description": "Android pieces shared by the waiter app and table tablet: the Keystore device key (a local Expo module), the secure store and AsyncStorage adapters (P2-01c, AUTH-007, SEC-010).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "android",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rp/api-client": "workspace:*",
    "@rp/mobile-core": "workspace:*"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.0",
    "expo-crypto": "^57.0.0",
    "expo-secure-store": "^57.0.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.25",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
