<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Background alerts on the waiter phone (P2-06b, WTR-005): a foreground service keeps it
    listening with the screen off, a notification per alert rings and vibrates. The table tablet
    blocks these permissions in its app config and never starts the service.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- The kind of network a tablet reports with its battery (P3-01b, TAB-015). -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!--
    The in-app updater (P7-04e2, WTR-001): the app installs its own new APK from the restaurant
    PC. Android asks the person on a phone; a device-owner tablet installs without asking.
  -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <application>
    <service
      android:name="com.rp.mobilenative.RpAlertService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Keeps a restaurant waiter's work phone connected to the restaurant's own server on the local network while the screen is off, so kitchen and table alerts for the waiter ring at once, like their pager." />
    </service>

    <receiver
      android:name="com.rp.mobilenative.RpAlertActionReceiver"
      android:exported="false" />

    <!-- Android's answer to an install of the app's new APK (P7-04e2). -->
    <receiver
      android:name="com.rp.mobilenative.RpApkInstallReceiver"
      android:exported="false" />

    <!-- The app was replaced by its new APK: a kiosk tablet opens it again (P7-04e2). -->
    <receiver
      android:name="com.rp.mobilenative.RpPackageReplacedReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!--
      The table tablet's device owner (P3-01b, TAB-001): only the system may bind it; it does
      nothing until MDM or `dpm set-device-owner` activates it.
    -->
    <receiver
      android:name="com.rp.mobilenative.RpDeviceAdminReceiver"
      android:description="@string/rp_device_admin_description"
      android:exported="true"
      android:label="@string/rp_device_admin_label"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/rp_device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
