{
  "name": "@rp/test-postgres",
  "version": "0.1.0",
  "private": true,
  "description": "Throwaway PostgreSQL 16 for integration tests: a temporary cluster or TEST_DATABASE_URL, a migrated template, one cloned database per test file.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1"
  }
}
