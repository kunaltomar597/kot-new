{
  "name": "@rp/ui-web",
  "version": "0.1.0",
  "private": true,
  "description": "React web component library for the console (POS, KDS, dashboard) and QR menu, built on @rp/design-tokens (NFR-U01).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "workbench": "storybook dev --port 6006 --no-open",
    "workbench:build": "storybook build --output-dir storybook-static --quiet",
    "clean": "rm -rf dist coverage storybook-static"
  },
  "dependencies": {
    "@rp/design-tokens": "workspace:*",
    "@rp/domain": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "vite": "^8.3.1"
  }
}
