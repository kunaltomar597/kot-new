{
  "name": "@rp/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed REST and Socket.io client for every app: device and staff tokens, refresh, idempotency keys, ApiError mapping and resync (AUTH-005, NFR-P11, NTF-006).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rp/contracts": "workspace:*",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  }
}
