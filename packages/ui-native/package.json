{
  "name": "@rp/ui-native",
  "version": "0.1.0",
  "private": true,
  "description": "React Native components for the waiter app and table tablet, matching @rp/ui-web in look and behaviour (NFR-U01, P2-01b).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rp/design-tokens": "workspace:*",
    "@rp/domain": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": ">=0.81"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "react": "^19.3.0",
    "react-native": "0.87.1",
    "test-renderer": "^1.3.0"
  }
}
