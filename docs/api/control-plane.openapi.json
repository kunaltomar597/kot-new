{
  "openapi": "3.1.1",
  "info": {
    "title": "Restaurant Operations Platform: Vendor Control Plane API",
    "version": "0.1.0",
    "description": "Generated from @rp/contracts/control-plane by `pnpm contracts:docs`; do not edit by hand. Restaurant PCs call it: `x-capability` is `INSTALLATION` for requests signed with the installation's Ed25519 key (headers x-rp-installation, x-rp-timestamp, x-rp-nonce and x-rp-signature over `signedRequestMessage`, ADR-0012) or `PUBLIC`. `x-requirements` lists the BRD requirement IDs."
  },
  "servers": [
    {
      "url": "https://control-plane.example.invalid",
      "description": "Set per environment (VCP-009)"
    }
  ],
  "tags": [
    { "name": "installations" },
    { "name": "onboarding" },
    { "name": "releases" },
    { "name": "system" }
  ],
  "paths": {
    "/v1/enrolments": {
      "post": {
        "operationId": "enrolInstallation",
        "summary": "Register a restaurant PC with a one-time enrolment code",
        "description": "Public because the installation has no credential yet: the one-time code and the proof that it holds the private key are its credential. Codes are used once and expire; attempts are rate-limited per client address.",
        "tags": ["installations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EnrolRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Enrolled.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EnrolResponse" } }
            }
          },
          "400": {
            "description": "The request does not match the contract.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "401": {
            "description": "Unknown, used or expired code, or a bad proof.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "429": {
            "description": "Too many attempts from this address.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        },
        "x-capability": "PUBLIC",
        "x-requirements": ["SEC-002", "ONB-003"]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getControlPlaneHealth",
        "summary": "Liveness and database status",
        "description": "Public because the load balancer and uptime monitoring call it; it reveals nothing but whether the service and its database answer.",
        "tags": ["system"],
        "responses": {
          "200": {
            "description": "Service and database are up.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          },
          "503": {
            "description": "The database is down.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        },
        "x-capability": "PUBLIC",
        "x-requirements": ["VCP-009"]
      }
    },
    "/v1/heartbeats": {
      "post": {
        "operationId": "postHeartbeat",
        "summary": "Report that an installation is alive, with its versions and health",
        "description": "Every 5 minutes by default; the answer sets the next interval, gives the server time and offers the release to update to. Sending the same heartbeat again is harmless.",
        "tags": ["installations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/HeartbeatRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HeartbeatResponse" } }
            }
          },
          "400": {
            "description": "The request does not match the contract.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "401": {
            "description": "Missing or invalid signature, unknown installation, reused nonce, or a clock outside the window (`CLOCK_SKEW`, with `details.serverTime`).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "403": {
            "description": "The vendor revoked this installation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        },
        "x-capability": "INSTALLATION",
        "x-requirements": ["VCP-005", "NFR-O03", "UPD-002", "UPD-010", "LIC-007"]
      }
    },
    "/v1/menu-extractions": {
      "post": {
        "operationId": "createMenuExtraction",
        "summary": "Read a printed menu from photos or a PDF (AI-assisted import)",
        "description": "ONB-006, VCP-008: the files are read by the AI provider, whose key only the Control Plane holds (SEC-002). The answer comes at once with the job; ask for it until it is DONE or FAILED (a menu takes about a minute). The files are deleted once read. What comes back is a draft that a person must check before anything is imported.",
        "tags": ["onboarding"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MenuExtractionRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MenuExtractionView" }
              }
            }
          },
          "400": {
            "description": "The request does not match the contract.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "401": {
            "description": "Missing or invalid signature, unknown installation, reused nonce, or a clock outside the window (`CLOCK_SKEW`, with `details.serverTime`).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "403": {
            "description": "The vendor revoked this installation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "429": {
            "description": "The daily number of menus is used up.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "503": {
            "description": "AI import is not set up.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        },
        "x-capability": "INSTALLATION",
        "x-requirements": ["ONB-006", "VCP-008", "SEC-002"]
      }
    },
    "/v1/menu-extractions/{extractionId}": {
      "get": {
        "operationId": "getMenuExtraction",
        "summary": "How reading a menu is going, and the draft once done",
        "tags": ["onboarding"],
        "parameters": [
          {
            "name": "extractionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MenuExtractionView" }
              }
            }
          },
          "400": {
            "description": "The request does not match the contract.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "401": {
            "description": "Missing or invalid signature, unknown installation, reused nonce, or a clock outside the window (`CLOCK_SKEW`, with `details.serverTime`).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "403": {
            "description": "The vendor revoked this installation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "404": {
            "description": "No such job for this restaurant.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        },
        "x-capability": "INSTALLATION",
        "x-requirements": ["ONB-006", "VCP-008"]
      }
    },
    "/v1/updates": {
      "get": {
        "operationId": "getUpdates",
        "summary": "The release an installation should move to from a given version",
        "tags": ["releases"],
        "parameters": [
          {
            "name": "component",
            "in": "query",
            "required": false,
            "schema": { "default": "RESTAURANT_PC", "type": "string", "enum": ["RESTAURANT_PC"] }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The update, or null when up to date.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UpdatesResponse" } }
            }
          },
          "400": {
            "description": "The request does not match the contract.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "401": {
            "description": "Missing or invalid signature, unknown installation, reused nonce, or a clock outside the window (`CLOCK_SKEW`, with `details.serverTime`).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          },
          "403": {
            "description": "The vendor revoked this installation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        },
        "x-capability": "INSTALLATION",
        "x-requirements": ["UPD-002", "UPD-007"]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "details": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {}
          },
          "correlationId": { "type": "string" }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "ComponentVersion": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "required": ["name", "version"],
        "additionalProperties": false
      },
      "DeviceLimits": {
        "type": "object",
        "properties": {
          "TABLE_TABLET": { "type": "integer", "minimum": 0, "maximum": 500 },
          "PAGER": { "type": "integer", "minimum": 0, "maximum": 500 },
          "WAITER_PHONE": { "type": "integer", "minimum": 0, "maximum": 500 },
          "KDS": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "required": ["TABLE_TABLET", "PAGER", "WAITER_PHONE", "KDS"],
        "additionalProperties": false
      },
      "EnrolRequest": {
        "type": "object",
        "properties": {
          "code": { "$ref": "#/components/schemas/EnrolmentCode" },
          "publicKey": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
          "proof": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
        },
        "required": ["code", "publicKey", "proof"],
        "additionalProperties": false
      },
      "EnrolResponse": {
        "type": "object",
        "properties": {
          "installationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": { "type": "string" },
          "channel": { "$ref": "#/components/schemas/ReleaseChannel" },
          "enrolledAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["installationId", "tenantId", "name", "channel", "enrolledAt"],
        "additionalProperties": false
      },
      "EnrolmentCode": {
        "type": "string",
        "pattern": "^[A-HJ-NP-Z2-9]{4}(-[A-HJ-NP-Z2-9]{4}){3}$"
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "time": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "uptimeSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["up", "down"] },
                  "latencyMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["status", "latencyMs"],
                "additionalProperties": false
              }
            },
            "required": ["database"],
            "additionalProperties": false
          }
        },
        "required": ["status", "time", "uptimeSeconds", "checks"],
        "additionalProperties": false
      },
      "HeartbeatRequest": {
        "type": "object",
        "properties": {
          "heartbeatId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "components": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": { "$ref": "#/components/schemas/ComponentVersion" }
          },
          "disk": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "totalBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "freeBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["totalBytes", "freeBytes"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "auditChainHead": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "sequence": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "hash": { "$ref": "#/components/schemas/Sha256Hex" }
                },
                "required": ["sequence", "hash"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "devices": {
            "type": "object",
            "propertyNames": { "type": "string", "pattern": "^[A-Z_]{1,40}$" },
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        "required": ["heartbeatId", "sentAt", "components", "disk", "auditChainHead", "devices"],
        "additionalProperties": {}
      },
      "HeartbeatResponse": {
        "type": "object",
        "properties": {
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "nextHeartbeatSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
          "update": {
            "anyOf": [{ "$ref": "#/components/schemas/ReleaseInfo" }, { "type": "null" }]
          }
        },
        "required": ["receivedAt", "serverTime", "nextHeartbeatSeconds", "update"],
        "additionalProperties": false
      },
      "LicenceModule": {
        "type": "string",
        "enum": [
          "POS",
          "KDS",
          "WAITER_APP",
          "TABLE_TABLET",
          "QR_MENU",
          "PAGERS",
          "RECOMMENDATIONS",
          "REPORTS"
        ]
      },
      "LicencePayload": {
        "type": "object",
        "properties": {
          "format": { "type": "number", "const": 1 },
          "licenceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "installationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fingerprint": {
            "minItems": 5,
            "maxItems": 5,
            "type": "array",
            "items": { "anyOf": [{ "$ref": "#/components/schemas/Sha256Hex" }, { "type": "null" }] }
          },
          "plan": { "type": "string", "minLength": 1, "maxLength": 40 },
          "modules": {
            "maxItems": 8,
            "type": "array",
            "items": { "$ref": "#/components/schemas/LicenceModule" }
          },
          "deviceLimits": { "$ref": "#/components/schemas/DeviceLimits" },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "graceDays": { "type": "integer", "minimum": 0, "maximum": 90 },
          "state": { "$ref": "#/components/schemas/LicenceState" },
          "graceStartedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              { "type": "null" }
            ]
          },
          "reason": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] }
        },
        "required": [
          "format",
          "licenceId",
          "tenantId",
          "installationId",
          "fingerprint",
          "plan",
          "modules",
          "deviceLimits",
          "issuedAt",
          "validUntil",
          "graceDays",
          "state",
          "graceStartedAt",
          "reason"
        ],
        "additionalProperties": false
      },
      "LicenceState": {
        "type": "string",
        "enum": ["ACTIVE", "PAYMENT_DUE", "GRACE", "RESTRICTED", "TERMINATED"]
      },
      "MenuDraft": {
        "type": "object",
        "properties": {
          "categories": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                "items": {
                  "minItems": 1,
                  "maxItems": 500,
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MenuDraftItem" }
                }
              },
              "required": ["name", "items"],
              "additionalProperties": false
            }
          },
          "addOns": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": { "type": "string", "minLength": 1, "maxLength": 60 },
                "options": {
                  "minItems": 1,
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                      "price": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                    },
                    "required": ["name", "price"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["group", "options"],
              "additionalProperties": false
            }
          },
          "notes": {
            "maxItems": 20,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "required": ["categories", "addOns", "notes"],
        "additionalProperties": false
      },
      "MenuDraftItem": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }]
          },
          "price": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "variants": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "price": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              },
              "required": ["name", "price"],
              "additionalProperties": false
            }
          },
          "foodType": {
            "anyOf": [{ "type": "string", "enum": ["VEG", "NON_VEG", "EGG"] }, { "type": "null" }]
          },
          "spiceLevel": {
            "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 3 }, { "type": "null" }]
          },
          "tags": {
            "maxItems": 10,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 30 }
          },
          "note": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }]
          }
        },
        "required": [
          "name",
          "description",
          "price",
          "variants",
          "foodType",
          "spiceLevel",
          "tags",
          "note"
        ],
        "additionalProperties": false
      },
      "MenuExtractionFile": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "contentType": {
            "type": "string",
            "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"]
          },
          "contentBase64": { "type": "string", "minLength": 4, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
        },
        "required": ["name", "contentType", "contentBase64"],
        "additionalProperties": false
      },
      "MenuExtractionParams": {
        "type": "object",
        "properties": {
          "extractionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["extractionId"],
        "additionalProperties": false
      },
      "MenuExtractionRequest": {
        "type": "object",
        "properties": {
          "files": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": { "$ref": "#/components/schemas/MenuExtractionFile" }
          }
        },
        "required": ["files"],
        "additionalProperties": false
      },
      "MenuExtractionStatus": { "type": "string", "enum": ["QUEUED", "RUNNING", "DONE", "FAILED"] },
      "MenuExtractionView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": { "$ref": "#/components/schemas/MenuExtractionStatus" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              { "type": "null" }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
                "required": ["code", "message"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "draft": { "anyOf": [{ "$ref": "#/components/schemas/MenuDraft" }, { "type": "null" }] }
        },
        "required": ["id", "status", "createdAt", "finishedAt", "error", "draft"],
        "additionalProperties": false
      },
      "ReactivationCode": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{4}(-?[0-9A-HJKMNP-TV-Z]{4}){3}$"
      },
      "ReleaseChannel": { "type": "string", "enum": ["STABLE", "PILOT"] },
      "ReleaseComponent": { "type": "string", "enum": ["RESTAURANT_PC"] },
      "ReleaseInfo": {
        "type": "object",
        "properties": {
          "component": { "$ref": "#/components/schemas/ReleaseComponent" },
          "channel": { "$ref": "#/components/schemas/ReleaseChannel" },
          "version": { "$ref": "#/components/schemas/SemVer" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "$ref": "#/components/schemas/Sha256Hex" },
          "sizeBytes": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
          "notes": { "anyOf": [{ "type": "string", "maxLength": 2000 }, { "type": "null" }] },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "component",
          "channel",
          "version",
          "url",
          "sha256",
          "sizeBytes",
          "notes",
          "publishedAt"
        ],
        "additionalProperties": false
      },
      "SemVer": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
      },
      "Sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "SignedLicence": {
        "type": "object",
        "properties": {
          "payload": { "type": "string", "minLength": 2, "maxLength": 8000 },
          "signature": { "type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
          "keyId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        },
        "required": ["payload", "signature", "keyId"],
        "additionalProperties": false
      },
      "UpdatesQuery": {
        "type": "object",
        "properties": {
          "component": {
            "default": "RESTAURANT_PC",
            "$ref": "#/components/schemas/ReleaseComponent"
          },
          "version": { "$ref": "#/components/schemas/SemVer" }
        },
        "required": ["component", "version"],
        "additionalProperties": false
      },
      "UpdatesQueryInput": {
        "type": "object",
        "properties": {
          "component": {
            "default": "RESTAURANT_PC",
            "$ref": "#/components/schemas/ReleaseComponent"
          },
          "version": { "$ref": "#/components/schemas/SemVer" }
        },
        "required": ["version"],
        "additionalProperties": false
      },
      "UpdatesResponse": {
        "type": "object",
        "properties": {
          "channel": { "$ref": "#/components/schemas/ReleaseChannel" },
          "update": {
            "anyOf": [{ "$ref": "#/components/schemas/ReleaseInfo" }, { "type": "null" }]
          }
        },
        "required": ["channel", "update"],
        "additionalProperties": false
      }
    }
  }
}
