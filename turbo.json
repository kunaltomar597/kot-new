{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "src/**",
        "scripts/**",
        "prisma/**",
        "package.json",
        "tsconfig*.json",
        "index.html",
        "public/**",
        "vite.config.*"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "src/**",
        "test/**",
        "fixtures/**",
        "stories/**",
        ".storybook/**",
        "package.json",
        "tsconfig*.json",
        "e2e/**",
        "*.config.ts"
      ]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "src/**",
        "test/**",
        "fixtures/**",
        "prisma/**",
        "package.json",
        "vitest.config.*"
      ],
      "env": ["TEST_DATABASE_URL", "PG_BIN"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "src/**",
        "test/**",
        "fixtures/**",
        "prisma/**",
        "package.json",
        "vitest.config.*"
      ],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL", "PG_BIN"]
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
