{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "prisma/**", "package.json", "tsconfig*.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig*.json"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "test/**", "prisma/**", "package.json", "vitest.config.*"],
      "env": ["TEST_DATABASE_URL", "PG_BIN"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "test/**", "prisma/**", "package.json", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL", "PG_BIN"]
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
