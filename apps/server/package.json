{
  "name": "@rp/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local server (C1): REST, real time, engines. Runs on the restaurant PC as a Windows service.",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist coverage src/generated",
    "db:seed": "node --env-file-if-exists=.env dist/database/seed-cli.js",
    "control-plane:enrol": "node --env-file-if-exists=.env dist/cloud/enrol-cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@peculiar/x509": "^2.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rp/contracts": "workspace:*",
    "@rp/domain": "workspace:*",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@rp/api-client": "workspace:*",
    "@rp/control-plane": "workspace:*",
    "@rp/test-postgres": "workspace:*",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0"
  }
}
