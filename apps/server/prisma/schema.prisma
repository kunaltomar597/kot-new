model Kot {
  id               String         @id @default(uuid(7)) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  businessDate     DateTime       @map("business_date") @db.Date
  /// Sequential per business day (ORD-008).
  kotNumber        Int            @map("kot_number")
  orderId          String         @map("order_id") @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id])
  stationId        String         @map("station_id") @db.Uuid
  station          Station        @relation(fields: [stationId], references: [id])
  kind             KotKind        @default(NEW)
  printStatus      KotPrintStatus @default(NOT_REQUIRED) @map("print_status")
  printedAt        DateTime?      @map("printed_at") @db.Timestamptz(3)
  printAttempts    Int            @default(0) @map("print_attempts")
  /// Bumped off the kitchen screen (KDS-005); cleared again by Recall.
  bumpedAt         DateTime?      @map("bumped_at") @db.Timestamptz(3)
  /// Who bumped it: the signed-in person, or none in station mode (the device is recorded).
  bumpedById       String?        @map("bumped_by_id") @db.Uuid
  bumpedByDeviceId String?        @map("bumped_by_device_id") @db.Uuid
  lines            KotLine[]
  alerts           Alert[]
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate, kotNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([stationId, businessDate])
  /// The kitchen screen lists a station's tickets not yet bumped (KDS-002).
  @@index([stationId, bumpedAt])
  /// The print queue (P1-07b) scans PENDING and FAILED tickets.
  @@index([restaurantId, printStatus])
  @@map("kots")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLEARED
}

/// Something a person must act on (NTF-001). P1-09 raises "ready, not collected" from the KDS
/// (KDS-006); the notification engine (P2-03) adds rules, delivery, acknowledgement and escalation.
model Alert {
  id               String      @id @default(uuid(7)) @db.Uuid
  restaurantId     String      @map("restaurant_id") @db.Uuid
  businessDate     DateTime    @map("business_date") @db.Date
  /// e.g. "READY_NOT_COLLECTED".
  type             String
  status           AlertStatus @default(OPEN)
  kotId            String?     @map("kot_id") @db.Uuid
  kot              Kot?        @relation(fields: [kotId], references: [id])
  tableId          String?     @map("table_id") @db.Uuid
  raisedById       String?     @map("raised_by_id") @db.Uuid
  raisedByDeviceId String?     @map("raised_by_device_id") @db.Uuid
  /// What the alert says, e.g. the table and the items waiting.
  payload          Json        @default("{}")
  acknowledgedAt   DateTime?   @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?     @map("acknowledged_by_id") @db.Uuid
  /// The table session or order the alert is about (P2-03).
  tableSessionId   String?     @map("table_session_id") @db.Uuid
  orderId          String?     @map("order_id") @db.Uuid
  /// One open alert per cause, e.g. "bill:<sessionId>": a repeated trigger does not stack alerts.
  dedupeKey        String?     @map("dedupe_key")
  /// Who is alerted now (the escalation adds the managers on duty).
  recipientIds     String[]    @default([]) @map("recipient_ids") @db.Uuid
  channels         String[]    @default([])
  pagerText        String?     @map("pager_text")
  /// Persisted deadlines, so repeats and escalation survive a restart (P2-03).
  escalateAt       DateTime?   @map("escalate_at") @db.Timestamptz(3)
  nextRepeatAt     DateTime?   @map("next_repeat_at") @db.Timestamptz(3)
  escalatedAt      DateTime?   @map("escalated_at") @db.Timestamptz(3)
  escalatedTo      String[]    @default([]) @map("escalated_to") @db.Uuid
  repeatCount      Int         @default(0) @map("repeat_count")
  clearedAt        DateTime?   @map("cleared_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, status])
  @@index([kotId])
  @@index([status, escalateAt])
  @@index([status, nextRepeatAt])
  @@index([restaurantId, dedupeKey])
  @@map("alerts")
}

/// A note printed at a station that is not a kitchen ticket, e.g. "Moved from T4 to T7" when a
/// table moves (TBL-005: tickets update in place, so nothing is printed again as a new ticket).
model PrintNotice {
  id            String         @id @default(uuid(7)) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  stationId     String         @map("station_id") @db.Uuid
  station       Station        @relation(fields: [stationId], references: [id])
  /// Large heading, e.g. "MOVED".
  title         String
  /// Lines under the heading ({text}[] as strings).
  lines         Json
  printStatus   KotPrintStatus @default(PENDING) @map("print_status")
  printedAt     DateTime?      @map("printed_at") @db.Timestamptz(3)
  printAttempts Int            @default(0) @map("print_attempts")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, printStatus])
  @@index([stationId, businessDate])
  @@map("print_notices")
}

model KotLine {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  kotId        String    @map("kot_id") @db.Uuid
  kot          Kot       @relation(fields: [kotId], references: [id])
  orderItemId  String    @map("order_item_id") @db.Uuid
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  /// Quantity on this ticket (negative on a MODIFIED ticket that reduces it).
  quantity     Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([kotId])
  @@index([orderItemId])
  @@map("kot_lines")
}

model Approval {
  id            String         @id @default(uuid(7)) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  /// What was asked for, e.g. "ORDER_APPROVE", "VOID_ITEM", "DISCOUNT_OVER_LIMIT" (AUTH-011).
  action        String
  status        ApprovalStatus @default(PENDING)
  orderId       String?        @map("order_id") @db.Uuid
  order         Order?         @relation(fields: [orderId], references: [id])
  requestedById String?        @map("requested_by_id") @db.Uuid
  approvedById  String?        @map("approved_by_id") @db.Uuid
  deviceId      String?        @map("device_id") @db.Uuid
  reason        String?
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, status])
  @@index([orderId])
  @@map("approvals")
}

model IdempotencyRecord {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Operation the key belongs to, e.g. "submitOrder".
  scope        String
  key          String   @db.Uuid
  /// SHA-256 of the canonical request, so a reused key with a different body is rejected.
  requestHash  String   @map("request_hash")
  statusCode   Int?     @map("status_code")
  response     Json?
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, scope, key])
  @@index([restaurantId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------- billing and cash

/// What a table session (dine-in) or a takeaway order will be billed for (P1-10, BILL-001):
/// discounts, the service charge choice and the customer's details before the invoice is issued.
model Bill {
  id                   String        @id @default(uuid(7)) @db.Uuid
  restaurantId         String        @map("restaurant_id") @db.Uuid
  businessDate         DateTime      @map("business_date") @db.Date
  tableSessionId       String?       @unique @map("table_session_id") @db.Uuid
  tableSession         TableSession? @relation(fields: [tableSessionId], references: [id])
  /// A takeaway order is billed on its own.
  orderId              String?       @unique @map("order_id") @db.Uuid
  order                Order?        @relation(fields: [orderId], references: [id])
  status               BillStatus    @default(OPEN)
  /// Removed at the diner's request (BILL-006), audited.
  serviceChargeRemoved Boolean       @default(false) @map("service_charge_removed")
  customerName         String?       @map("customer_name")
  customerPhone        String?       @map("customer_phone")
  /// Explicit consent to a digital bill or feedback on this number (BILL-011).
  customerPhoneConsent Boolean       @default(false) @map("customer_phone_consent")
  customerGstin        String?       @map("customer_gstin")
  /// Set while a printed invoice is reopened for editing (BILL-010); the next issue updates it in
  /// place, keeping its number.
  editingInvoiceId     String?       @map("editing_invoice_id") @db.Uuid
  editReason           String?       @map("edit_reason")
  editRequestedById    String?       @map("edit_requested_by_id") @db.Uuid
  editApprovedById     String?       @map("edit_approved_by_id") @db.Uuid
  discounts            Discount[]
  invoices             Invoice[]
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@map("bills")
}

model Invoice {
  id                   String        @id @default(uuid(7)) @db.Uuid
  restaurantId         String        @map("restaurant_id") @db.Uuid
  businessDate         DateTime      @map("business_date") @db.Date
  /// Date of issue in IST; decides the financial year (ADR-0007).
  invoiceDate          DateTime      @map("invoice_date") @db.Date
  financialYear        String        @map("financial_year")
  seriesId             String        @map("series_id") @db.Uuid
  series               InvoiceSeries @relation(fields: [seriesId], references: [id])
  sequence             Int
  invoiceNumber        String        @map("invoice_number")
  status               InvoiceStatus @default(ISSUED)
  orderId              String?       @map("order_id") @db.Uuid
  order                Order?        @relation(fields: [orderId], references: [id])
  tableSessionId       String?       @map("table_session_id") @db.Uuid
  tableSession         TableSession? @relation(fields: [tableSessionId], references: [id])
  billId               String?       @map("bill_id") @db.Uuid
  bill                 Bill?         @relation(fields: [billId], references: [id])
  /// The seller's invoice particulars as printed (BILL-002): legal name, address, GSTIN, FSSAI,
  /// place of supply, header and footer. Later profile changes never alter an issued invoice.
  particulars          Json          @default("{}")
  priceMode            PriceMode     @map("price_mode")
  subtotal             Int
  discountTotal        Int           @default(0) @map("discount_total")
  serviceCharge        Int           @default(0) @map("service_charge")
  taxTotal             Int           @map("tax_total")
  /// Signed rounding adjustment.
  roundOff             Int           @default(0) @map("round_off")
  grandTotal           Int           @map("grand_total")
  customerName         String?       @map("customer_name")
  customerGstin        String?       @map("customer_gstin")
  customerPhone        String?       @map("customer_phone")
  customerPhoneConsent Boolean       @default(false) @map("customer_phone_consent")
  issuedById           String        @map("issued_by_id") @db.Uuid
  issuedAt             DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  settledAt            DateTime?     @map("settled_at") @db.Timestamptz(3)
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason           String?       @map("void_reason")
  /// A re-issued invoice points at the voided one it replaces (BILL-010).
  replacesInvoiceId    String?       @map("replaces_invoice_id") @db.Uuid
  replaces             Invoice?      @relation("Reissue", fields: [replacesInvoiceId], references: [id])
  replacedBy           Invoice[]     @relation("Reissue")
  printCount           Int           @default(0) @map("print_count")
  /// Bumped by every edit of a printed bill (BILL-010), for optimistic locking.
  version              Int           @default(1)
  lines                InvoiceLine[]
  taxLines             TaxLine[]
  discounts            Discount[]
  payments             Payment[]
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, invoiceNumber])
  @@unique([seriesId, financialYear, sequence])
  @@index([restaurantId, businessDate])
  @@index([tableSessionId])
  @@index([billId])
  /// The invoice register and GST reports read by invoice date (RPT-006, RPT-018).
  @@index([restaurantId, invoiceDate])
  @@map("invoices")
}

model InvoiceLine {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  invoiceId    String     @map("invoice_id") @db.Uuid
  invoice      Invoice    @relation(fields: [invoiceId], references: [id])
  orderItemId  String?    @map("order_item_id") @db.Uuid
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id])
  description  String
  quantity     Int
  unitPrice    Int        @map("unit_price")
  lineTotal    Int        @map("line_total")
  discount     Int        @default(0)
  taxableValue Int        @map("taxable_value")
  taxGroupId   String?    @map("tax_group_id") @db.Uuid
  sacCode      String?    @map("sac_code")
  /// The invoice version this line belongs to. An edited invoice (BILL-010) gets new lines under
  /// its next version; earlier lines stay for the audit trail, since lines are never deleted.
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model TaxLine {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  taxGroupId   String   @map("tax_group_id") @db.Uuid
  code         String
  rateBp       Int      @map("rate_bp")
  taxableValue Int      @map("taxable_value")
  amount       Int
  /// As on invoice lines: the invoice version this tax line belongs to.
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([invoiceId])
  @@map("tax_lines")
}

model Discount {
  id           String       @id @default(uuid(7)) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  businessDate DateTime     @map("business_date") @db.Date
  invoiceId    String?      @map("invoice_id") @db.Uuid
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  billId       String?      @map("bill_id") @db.Uuid
  bill         Bill?        @relation(fields: [billId], references: [id])
  /// Item discount when set; a bill discount otherwise.
  orderItemId  String?      @map("order_item_id") @db.Uuid
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])
  kind         DiscountKind
  /// Percentage in basis points for PERCENT discounts.
  rateBp       Int?         @map("rate_bp")
  amount       Int
  /// Mandatory (BILL-005).
  reason       String
  appliedById  String       @map("applied_by_id") @db.Uuid
  approvedById String?      @map("approved_by_id") @db.Uuid
  /// Discounts are never deleted: one taken back before printing is revoked, audited.
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedById  String?      @map("revoked_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([billId])
  @@index([restaurantId, businessDate])
  @@map("discounts")
}

model Shift {
  id            String         @id @default(uuid(7)) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  staffId       String         @map("staff_id") @db.Uuid
  staff         Staff          @relation(fields: [staffId], references: [id])
  deviceId      String?        @map("device_id") @db.Uuid
  status        ShiftStatus    @default(OPEN)
  openedAt      DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt      DateTime?      @map("closed_at") @db.Timestamptz(3)
  openingFloat  BigInt         @map("opening_float")
  expectedCash  BigInt?        @map("expected_cash")
  countedCash   BigInt?        @map("counted_cash")
  variance      BigInt?
  /// Denomination count (S requirement), e.g. {"500": 4, "100": 12}.
  denominations Json?
  payments      Payment[]
  cashMovements CashMovement[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@map("shifts")
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  businessDate DateTime      @map("business_date") @db.Date
  invoiceId    String        @map("invoice_id") @db.Uuid
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  shiftId      String?       @map("shift_id") @db.Uuid
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  mode         PaymentMode
  /// The restaurant's name for an OTHER mode, e.g. "Swiggy Dineout" (`payments.otherModes`).
  modeLabel    String?       @map("mode_label")
  status       PaymentStatus @default(CAPTURED)
  amount       Int
  /// Cash handed over and change returned, for cash payments.
  tendered     Int?
  change       Int?
  /// Card slip or UPI reference.
  reference    String?
  receivedById String        @map("received_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([restaurantId, businessDate])
  @@map("payments")
}

model CashMovement {
  id           String        @id @default(uuid(7)) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  businessDate DateTime      @map("business_date") @db.Date
  shiftId      String        @map("shift_id") @db.Uuid
  shift        Shift         @relation(fields: [shiftId], references: [id])
  direction    CashDirection
  amount       Int
  reason       String
  staffId      String        @map("staff_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([shiftId])
  @@map("cash_movements")
}

model DayEnd {
  id            String   @id @default(uuid(7)) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  businessDate  DateTime @map("business_date") @db.Date
  closedById    String   @map("closed_by_id") @db.Uuid
  closedAt      DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  grossSales    BigInt   @map("gross_sales")
  discountTotal BigInt   @map("discount_total")
  taxTotal      BigInt   @map("tax_total")
  netSales      BigInt   @map("net_sales")
  /// Full Z-report figures as computed at close.
  report        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("day_ends")
}

// ---------------------------------------------------------------- audit and messaging

/// How far each durable event consumer has got (P0-12). Consumers handle events in sequence order,
/// at least once, de-duplicated through the inbox. Installation-level, like the outbox sequence
/// (one installation per outlet, BRD assumption A-01).
model EventConsumerCursor {
  id           String   @id @default(uuid(7)) @db.Uuid
  consumer     String   @unique
  lastSequence BigInt   @default(0) @map("last_sequence")
  attempts     Int      @default(0)
  lastError    String?  @map("last_error")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_consumer_cursors")
}

model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  businessDate  DateTime @map("business_date") @db.Date
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// e.g. "ORDER_ITEM_VOIDED", "DISCOUNT_APPLIED", "LOGIN_FAILED" (AUD-001).
  action        String
  actorId       String?  @map("actor_id") @db.Uuid
  approverId    String?  @map("approver_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  reason        String?
  correlationId String?  @map("correlation_id")
  /// Position in the hash chain (1, 2, 3, ...), allocated under an advisory lock (P0-09).
  chainSeq      BigInt   @unique @map("chain_seq")
  /// Hash of the previous entry (64 zeros for the first); see src/audit/audit-hash.ts.
  prevHash      String   @map("prev_hash")
  /// SHA-256 of the canonical entry plus prevHash (AUD-003).
  hash          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  restaurantId  String    @map("restaurant_id") @db.Uuid
  /// Versioned domain event name, e.g. "OrderApproved" (contracts events).
  eventType     String    @map("event_type")
  eventVersion  Int       @default(1) @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  /// Delivery order: gap-free, assigned by the event dispatcher when the committed event is
  /// published, so clients can resume from the last sequence they saw (NFR-P11, NTF-006).
  sequence      BigInt?   @unique
  /// Order in which rows were written (keeps a transaction's events in order); not commit order.
  writeOrder    BigInt    @default(autoincrement()) @map("write_order")
  /// Routing hints from the producer (tables, stations, sections, staff) for real-time rooms.
  audience      Json?
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([publishedAt, occurredAt])
  @@map("outbox")
}

model InboxMessage {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  /// Sender, e.g. "qr-relay" (P5-03); with message_id it de-duplicates redeliveries.
  source       String
  messageId    String    @map("message_id")
  payload      Json
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([source, messageId])
  @@index([restaurantId])
  @@map("inbox")
}
