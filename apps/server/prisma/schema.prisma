// ---------------------------------------------------------------- orders and kitchen

model Order {
  id             String        @id @default(uuid(7)) @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  businessDate   DateTime      @map("business_date") @db.Date
  /// Sequential per business day (ADR-0005).
  orderNumber    Int           @map("order_number")
  orderType      OrderType     @map("order_type")
  source         OrderSource
  status         OrderStatus   @default(OPEN)
  tableSessionId String?       @map("table_session_id") @db.Uuid
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  tableId        String?       @map("table_id") @db.Uuid
  table          DiningTable?  @relation(fields: [tableId], references: [id])
  takeawayToken  Int?          @map("takeaway_token")
  createdById    String?       @map("created_by_id") @db.Uuid
  deviceId       String?       @map("device_id") @db.Uuid
  customerName   String?       @map("customer_name")
  customerPhone  String?       @map("customer_phone")
  notes          String?
  /// Reference in the originating system, e.g. a QR relay order id (INT-005).
  externalRef    String?       @map("external_ref")
  items          OrderItem[]
  events         OrderEvent[]
  kots           Kot[]
  approvals      Approval[]
  invoices       Invoice[]
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate, orderNumber])
  @@index([tableSessionId])
  @@index([restaurantId, source, externalRef])
  @@map("orders")
}

model OrderItem {
  id                String              @id @default(uuid(7)) @db.Uuid
  restaurantId      String              @map("restaurant_id") @db.Uuid
  orderId           String              @map("order_id") @db.Uuid
  order             Order               @relation(fields: [orderId], references: [id])
  businessDate      DateTime            @map("business_date") @db.Date
  itemId            String              @map("item_id") @db.Uuid
  item              Item                @relation(fields: [itemId], references: [id])
  variantId         String?             @map("variant_id") @db.Uuid
  variant           Variant?            @relation(fields: [variantId], references: [id])
  /// Combo component lines point at the combo's own order item.
  parentOrderItemId String?             @map("parent_order_item_id") @db.Uuid
  parent            OrderItem?          @relation("ComboLines", fields: [parentOrderItemId], references: [id])
  components        OrderItem[]         @relation("ComboLines")
  /// Names and prices as they were when ordered; menu edits never change past orders.
  name              String
  variantName       String?             @map("variant_name")
  quantity          Int
  unitPrice         Int                 @map("unit_price")
  lineTotal         Int                 @map("line_total")
  taxGroupId        String              @map("tax_group_id") @db.Uuid
  /// Tax rates at the time of ordering ({code, rateBp}[]).
  taxRates          Json                @map("tax_rates")
  stationId         String              @map("station_id") @db.Uuid
  state             OrderItemState
  instructions      String?
  createdById       String?             @map("created_by_id") @db.Uuid
  approvedById      String?             @map("approved_by_id") @db.Uuid
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  preparingAt       DateTime?           @map("preparing_at") @db.Timestamptz(3)
  readyAt           DateTime?           @map("ready_at") @db.Timestamptz(3)
  pickedUpAt        DateTime?           @map("picked_up_at") @db.Timestamptz(3)
  servedAt          DateTime?           @map("served_at") @db.Timestamptz(3)
  endedAt           DateTime?           @map("ended_at") @db.Timestamptz(3)
  /// Reason for reject, cancel or void (ORD-011).
  endReason         String?             @map("end_reason")
  modifiers         OrderItemModifier[]
  kotLines          KotLine[]
  events            OrderEvent[]
  discounts         Discount[]
  invoiceLines      InvoiceLine[]
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orderId])
  @@index([restaurantId, businessDate, state])
  @@index([stationId, state])
  @@map("order_items")
}

model OrderItemModifier {
  id               String         @id @default(uuid(7)) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  orderItemId      String         @map("order_item_id") @db.Uuid
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id])
  modifierOptionId String         @map("modifier_option_id") @db.Uuid
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  name             String
  priceDelta       Int            @map("price_delta")
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderEvent {
  id           String          @id @default(uuid(7)) @db.Uuid
  restaurantId String          @map("restaurant_id") @db.Uuid
  orderId      String          @map("order_id") @db.Uuid
  order        Order           @relation(fields: [orderId], references: [id])
  orderItemId  String?         @map("order_item_id") @db.Uuid
  orderItem    OrderItem?      @relation(fields: [orderItemId], references: [id])
  businessDate DateTime        @map("business_date") @db.Date
  /// Domain event name, e.g. "OrderItemStateChanged".
  type         String
  fromState    OrderItemState? @map("from_state")
  toState      OrderItemState? @map("to_state")
  actorId      String?         @map("actor_id") @db.Uuid
  deviceId     String?         @map("device_id") @db.Uuid
  payload      Json            @default("{}")
  occurredAt   DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([orderId])
  @@map("order_events")
}

model Kot {
  id            String         @id @default(uuid(7)) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  /// Sequential per business day (ORD-008).
  kotNumber     Int            @map("kot_number")
  orderId       String         @map("order_id") @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id])
  stationId     String         @map("station_id") @db.Uuid
  station       Station        @relation(fields: [stationId], references: [id])
  kind          KotKind        @default(NEW)
  printStatus   KotPrintStatus @default(NOT_REQUIRED) @map("print_status")
  printedAt     DateTime?      @map("printed_at") @db.Timestamptz(3)
  printAttempts Int            @default(0) @map("print_attempts")
  lines         KotLine[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate, kotNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([stationId, businessDate])
  @@map("kots")
}

model KotLine {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  kotId        String    @map("kot_id") @db.Uuid
  kot          Kot       @relation(fields: [kotId], references: [id])
  orderItemId  String    @map("order_item_id") @db.Uuid
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  /// Quantity on this ticket (negative on a MODIFIED ticket that reduces it).
  quantity     Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([kotId])
  @@index([orderItemId])
  @@map("kot_lines")
}

model Approval {
  id            String         @id @default(uuid(7)) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  /// What was asked for, e.g. "ORDER_APPROVE", "VOID_ITEM", "DISCOUNT_OVER_LIMIT" (AUTH-011).
  action        String
  status        ApprovalStatus @default(PENDING)
  orderId       String?        @map("order_id") @db.Uuid
  order         Order?         @relation(fields: [orderId], references: [id])
  requestedById String?        @map("requested_by_id") @db.Uuid
  approvedById  String?        @map("approved_by_id") @db.Uuid
  deviceId      String?        @map("device_id") @db.Uuid
  reason        String?
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, status])
  @@index([orderId])
  @@map("approvals")
}

model IdempotencyRecord {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Operation the key belongs to, e.g. "submitOrder".
  scope        String
  key          String   @db.Uuid
  /// SHA-256 of the canonical request, so a reused key with a different body is rejected.
  requestHash  String   @map("request_hash")
  statusCode   Int?     @map("status_code")
  response     Json?
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, scope, key])
  @@index([restaurantId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------- billing and cash

model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  restaurantId      String        @map("restaurant_id") @db.Uuid
  businessDate      DateTime      @map("business_date") @db.Date
  /// Date of issue in IST; decides the financial year (ADR-0007).
  invoiceDate       DateTime      @map("invoice_date") @db.Date
  financialYear     String        @map("financial_year")
  seriesId          String        @map("series_id") @db.Uuid
  series            InvoiceSeries @relation(fields: [seriesId], references: [id])
  sequence          Int
  invoiceNumber     String        @map("invoice_number")
  status            InvoiceStatus @default(ISSUED)
  orderId           String?       @map("order_id") @db.Uuid
  order             Order?        @relation(fields: [orderId], references: [id])
  tableSessionId    String?       @map("table_session_id") @db.Uuid
  tableSession      TableSession? @relation(fields: [tableSessionId], references: [id])
  priceMode         PriceMode     @map("price_mode")
  subtotal          Int
  discountTotal     Int           @default(0) @map("discount_total")
  serviceCharge     Int           @default(0) @map("service_charge")
  taxTotal          Int           @map("tax_total")
  /// Signed rounding adjustment.
  roundOff          Int           @default(0) @map("round_off")
  grandTotal        Int           @map("grand_total")
  customerName      String?       @map("customer_name")
  customerGstin     String?       @map("customer_gstin")
  customerPhone     String?       @map("customer_phone")
  issuedById        String        @map("issued_by_id") @db.Uuid
  issuedAt          DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  settledAt         DateTime?     @map("settled_at") @db.Timestamptz(3)
  voidedAt          DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason        String?       @map("void_reason")
  /// A re-issued invoice points at the voided one it replaces (BILL-010).
  replacesInvoiceId String?       @map("replaces_invoice_id") @db.Uuid
  replaces          Invoice?      @relation("Reissue", fields: [replacesInvoiceId], references: [id])
  replacedBy        Invoice[]     @relation("Reissue")
  printCount        Int           @default(0) @map("print_count")
  /// Bumped by every edit of a printed bill (BILL-010), for optimistic locking.
  version           Int           @default(1)
  lines             InvoiceLine[]
  taxLines          TaxLine[]
  discounts         Discount[]
  payments          Payment[]
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, invoiceNumber])
  @@unique([seriesId, financialYear, sequence])
  @@index([restaurantId, businessDate])
  @@index([tableSessionId])
  @@map("invoices")
}

model InvoiceLine {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  invoiceId    String     @map("invoice_id") @db.Uuid
  invoice      Invoice    @relation(fields: [invoiceId], references: [id])
  orderItemId  String?    @map("order_item_id") @db.Uuid
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id])
  description  String
  quantity     Int
  unitPrice    Int        @map("unit_price")
  lineTotal    Int        @map("line_total")
  discount     Int        @default(0)
  taxableValue Int        @map("taxable_value")
  taxGroupId   String?    @map("tax_group_id") @db.Uuid
  sacCode      String?    @map("sac_code")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model TaxLine {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  taxGroupId   String   @map("tax_group_id") @db.Uuid
  code         String
  rateBp       Int      @map("rate_bp")
  taxableValue Int      @map("taxable_value")
  amount       Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([invoiceId])
  @@map("tax_lines")
}

model Discount {
  id           String       @id @default(uuid(7)) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  businessDate DateTime     @map("business_date") @db.Date
  invoiceId    String?      @map("invoice_id") @db.Uuid
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  orderItemId  String?      @map("order_item_id") @db.Uuid
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])
  kind         DiscountKind
  /// Percentage in basis points for PERCENT discounts.
  rateBp       Int?         @map("rate_bp")
  amount       Int
  /// Mandatory (BILL-005).
  reason       String
  appliedById  String       @map("applied_by_id") @db.Uuid
  approvedById String?      @map("approved_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([restaurantId, businessDate])
  @@map("discounts")
}

model Shift {
  id            String         @id @default(uuid(7)) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  staffId       String         @map("staff_id") @db.Uuid
  staff         Staff          @relation(fields: [staffId], references: [id])
  deviceId      String?        @map("device_id") @db.Uuid
  status        ShiftStatus    @default(OPEN)
  openedAt      DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt      DateTime?      @map("closed_at") @db.Timestamptz(3)
  openingFloat  BigInt         @map("opening_float")
  expectedCash  BigInt?        @map("expected_cash")
  countedCash   BigInt?        @map("counted_cash")
  variance      BigInt?
  /// Denomination count (S requirement), e.g. {"500": 4, "100": 12}.
  denominations Json?
  payments      Payment[]
  cashMovements CashMovement[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@map("shifts")
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  businessDate DateTime      @map("business_date") @db.Date
  invoiceId    String        @map("invoice_id") @db.Uuid
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  shiftId      String?       @map("shift_id") @db.Uuid
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  mode         PaymentMode
  status       PaymentStatus @default(CAPTURED)
  amount       Int
  /// Cash handed over and change returned, for cash payments.
  tendered     Int?
  change       Int?
  /// Card slip or UPI reference.
  reference    String?
  receivedById String        @map("received_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([restaurantId, businessDate])
  @@map("payments")
}

model CashMovement {
  id           String        @id @default(uuid(7)) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  businessDate DateTime      @map("business_date") @db.Date
  shiftId      String        @map("shift_id") @db.Uuid
  shift        Shift         @relation(fields: [shiftId], references: [id])
  direction    CashDirection
  amount       Int
  reason       String
  staffId      String        @map("staff_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([shiftId])
  @@map("cash_movements")
}

model DayEnd {
  id            String   @id @default(uuid(7)) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  businessDate  DateTime @map("business_date") @db.Date
  closedById    String   @map("closed_by_id") @db.Uuid
  closedAt      DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  grossSales    BigInt   @map("gross_sales")
  discountTotal BigInt   @map("discount_total")
  taxTotal      BigInt   @map("tax_total")
  netSales      BigInt   @map("net_sales")
  /// Full Z-report figures as computed at close.
  report        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("day_ends")
}

// ---------------------------------------------------------------- audit and messaging

model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  businessDate  DateTime @map("business_date") @db.Date
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// e.g. "ORDER_ITEM_VOIDED", "DISCOUNT_APPLIED", "LOGIN_FAILED" (AUD-001).
  action        String
  actorId       String?  @map("actor_id") @db.Uuid
  approverId    String?  @map("approver_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  reason        String?
  correlationId String?  @map("correlation_id")
  /// Position in the hash chain (1, 2, 3, ...), allocated under an advisory lock (P0-09).
  chainSeq      BigInt   @unique @map("chain_seq")
  /// Hash of the previous entry (64 zeros for the first); see src/audit/audit-hash.ts.
  prevHash      String   @map("prev_hash")
  /// SHA-256 of the canonical entry plus prevHash (AUD-003).
  hash          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  restaurantId  String    @map("restaurant_id") @db.Uuid
  /// Versioned domain event name, e.g. "OrderApproved" (contracts events).
  eventType     String    @map("event_type")
  eventVersion  Int       @default(1) @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([publishedAt, occurredAt])
  @@map("outbox")
}

model InboxMessage {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  /// Sender, e.g. "qr-relay" (P5-03); with message_id it de-duplicates redeliveries.
  source       String
  messageId    String    @map("message_id")
  payload      Json
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([source, messageId])
  @@index([restaurantId])
  @@map("inbox")
}
