// Restaurant Operations Platform: local database schema.
// Conventions (docs/build/CONVENTIONS.md, ADR-0005): UUIDv7 ids generated by the client,
// restaurant_id on every table, snake_case table and column names, money as integer paise.
// P0-08 core data model (docs/build/phases/phase-0.md):
// - every table has id (UUIDv7), restaurant_id, created_at, updated_at; restaurant_id is an indexed
//   column without a foreign key because the local database holds exactly one restaurant (SEC-005);
// - business records carry business_date (DATE, cut-off 04:00 IST by default);
// - money is Int paise (BigInt for day and shift aggregates), rates are Int basis points;
// - financial and audit tables are protected by roles and triggers in the P0-08 migration (AUD-004);
// - master data is archived (archived_at), never deleted.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums (mirror @rp/domain)

/// Built-in roles (@rp/domain ROLES).
enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum CredentialKind {
  PIN
  PASSWORD
  TOTP
}

enum DeviceType {
  POS
  KDS
  WAITER_PHONE
  TABLE_TABLET
  PAGER
  MANAGER_BROWSER
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

/// @rp/domain TABLE_STATES.
enum TableState {
  FREE
  OCCUPIED
  BILL_REQUESTED
  BILL_PRINTED
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum StationMode {
  SCREEN
  PRINT
  BOTH
}

enum PrinterConnection {
  NETWORK
  USB
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum SalesChannel {
  POS
  WAITER_APP
  TABLE_TABLET
  QR
}

enum PriceMode {
  TAX_EXCLUSIVE
  TAX_INCLUSIVE
}

enum ComboComponentKind {
  FIXED
  CHOICE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

/// @rp/domain ORDER_SOURCES.
enum OrderSource {
  POS
  WAITER_APP
  TABLE_TABLET
  QR
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// @rp/domain ORDER_ITEM_STATES.
enum OrderItemState {
  PENDING_APPROVAL
  SENT
  PREPARING
  READY
  PICKED_UP
  SERVED
  REJECTED
  CANCELLED
  VOIDED
}

enum KotKind {
  NEW
  MODIFIED
  CANCELLED
}

enum KotPrintStatus {
  NOT_REQUIRED
  PENDING
  PRINTED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// A bill is OPEN while it can still change before printing, INVOICED once printed (P1-10).
enum BillStatus {
  OPEN
  INVOICED
}

enum InvoiceStatus {
  ISSUED
  SETTLED
  VOIDED
}

enum DiscountKind {
  PERCENT
  FLAT
}

enum PaymentMode {
  CASH
  CARD
  UPI
  OTHER
}

enum PaymentStatus {
  CAPTURED
  REFUNDED
  VOIDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashDirection {
  IN
  OUT
}

/// Per-business-day human numbers (ADR-0005).
enum CounterKind {
  ORDER
  KOT
  TAKEAWAY_TOKEN
}

// ---------------------------------------------------------------- restaurant and system

/// The restaurant this installation serves. The local database holds exactly one (SEC-005),
/// but every record still carries restaurant_id for consistency with the cloud.
model Restaurant {
  id                String   @id @default(uuid(7)) @db.Uuid
  legalName         String?  @map("legal_name")
  displayName       String   @map("display_name")
  gstin             String?
  fssaiNumber       String?  @map("fssai_number")
  /// GST state code (two digits) of the place of supply.
  stateCode         String?  @map("state_code")
  /// The `Address` contract (P1-01b); the state is `stateCode`.
  address           Json?
  phone             String?
  email             String?
  /// Opening hours, the `BusinessHours` contract: `[{ day, start, end }]` (ONB-004).
  businessHours     Json     @default("[]") @map("business_hours")
  logoPhotoId       String?  @map("logo_photo_id") @db.Uuid
  /// Restrict: a photo in use as the logo is never removed by photo clean-up (P1-04).
  logoPhoto         Photo?   @relation(fields: [logoPhotoId], references: [id], onDelete: Restrict)
  timeZone          String   @default("Asia/Kolkata") @map("time_zone")
  /// Business-day cut-off, local time HH:MM (default 04:00).
  businessDayCutoff String   @default("04:00") @map("business_day_cutoff")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("restaurants")
}

/// Installation-level key/value facts (schema version markers, installation id).
model SystemMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_meta")
}

model Setting {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Settings-registry key (P1-01), e.g. "billing.serviceCharge.enabled".
  key          String
  value        Json
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("settings")
}

model BusinessDay {
  id           String            @id @default(uuid(7)) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  businessDate DateTime          @map("business_date") @db.Date
  status       BusinessDayStatus @default(OPEN)
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById   String?           @map("closed_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("business_days")
}

model DailyCounter {
  id           String      @id @default(uuid(7)) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  businessDate DateTime    @map("business_date") @db.Date
  kind         CounterKind
  /// Last number handed out; the next is allocated with a row lock inside the caller's transaction.
  lastValue    Int         @default(0) @map("last_value")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate, kind])
  @@index([restaurantId])
  @@map("daily_counters")
}

// ---------------------------------------------------------------- staff, access, devices

model Role {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  /// Stable key, e.g. "MANAGER"; custom roles (later) get their own keys.
  key          String
  name         String
  baseRole     StaffRole @map("base_role")
  builtIn      Boolean   @default(true) @map("built_in")
  /// Extra capabilities granted on top of the base role (custom roles, later WPs).
  capabilities String[]  @default([])
  staff        Staff[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("roles")
}

model Staff {
  id               String            @id @default(uuid(7)) @db.Uuid
  restaurantId     String            @map("restaurant_id") @db.Uuid
  roleId           String            @map("role_id") @db.Uuid
  role             Role              @relation(fields: [roleId], references: [id])
  displayName      String            @map("display_name")
  photoId          String?           @map("photo_id") @db.Uuid
  phone            String?
  email            String?
  active           Boolean           @default(true)
  externalId       String?           @map("external_id")
  /// Set while the person is on break: their alerts go to the managers (NTF-009, P2-03b).
  onBreakSince     DateTime?         @map("on_break_since") @db.Timestamptz(3)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  credentials      Credential[]
  sessions         Session[]
  recoveryCodes    RecoveryCode[]
  pagers           Device[]
  shiftAssignments ShiftAssignment[]
  shifts           Shift[]
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, active])
  @@map("staff")
}

model Credential {
  id                     String         @id @default(uuid(7)) @db.Uuid
  restaurantId           String         @map("restaurant_id") @db.Uuid
  staffId                String         @map("staff_id") @db.Uuid
  staff                  Staff          @relation(fields: [staffId], references: [id])
  kind                   CredentialKind
  /// bcrypt/Argon2id hash of PIN + pepper, or password hash, or encrypted TOTP secret (AUTH-002).
  secretHash             String         @map("secret_hash")
  failedAttempts         Int            @default(0) @map("failed_attempts")
  /// Start of the current failure window (AUTH-003: 5 failures within 10 minutes lock the login).
  failureWindowStartedAt DateTime?      @map("failure_window_started_at") @db.Timestamptz(3)
  lockedUntil            DateTime?      @map("locked_until") @db.Timestamptz(3)
  /// TOTP only: encrypted secret waiting for its first code (enrolment in progress).
  pendingSecret          String?        @map("pending_secret")
  /// TOTP only: when the current secret was confirmed; unconfirmed TOTP is not a second factor.
  confirmedAt            DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  /// TOTP only: last accepted 30-second step, so a code can never be used twice.
  lastTotpStep           BigInt?        @map("last_totp_step")
  rotatedAt              DateTime       @default(now()) @map("rotated_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([staffId, kind])
  @@index([restaurantId])
  @@map("credentials")
}

model Device {
  id                     String       @id @default(uuid(7)) @db.Uuid
  restaurantId           String       @map("restaurant_id") @db.Uuid
  type                   DeviceType
  name                   String
  status                 DeviceStatus @default(PENDING)
  /// Device public key (SPKI PEM) registered at pairing (AUTH-007).
  publicKey              String?      @map("public_key")
  /// "Ed25519" or "ES256".
  keyAlgorithm           String?      @map("key_algorithm")
  certificateFingerprint String?      @map("certificate_fingerprint")
  pairedAt               DateTime?    @map("paired_at") @db.Timestamptz(3)
  pairedById             String?      @map("paired_by_id") @db.Uuid
  revokedAt              DateTime?    @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt             DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  appVersion             String?      @map("app_version")
  /// Table a table tablet is bound to (AUTH-009).
  tableId                String?      @map("table_id") @db.Uuid
  table                  DiningTable? @relation(fields: [tableId], references: [id])
  /// Station a kitchen screen shows (KDS-002).
  stationId              String?      @map("station_id") @db.Uuid
  station                Station?     @relation(fields: [stationId], references: [id])
  /// Person wearing a pager.
  staffId                String?      @map("staff_id") @db.Uuid
  /// Serial printed (and in the QR code) on a pager (PGR-012).
  serial                 String?
  /// SHA-256 of the pager's MQTT secret (SEC-012); the secret is shown once when issued (P2-04).
  mqttSecretHash         String?      @map("mqtt_secret_hash")
  /// Last heartbeat's battery, signal and firmware (PGR-007).
  batteryPercent         Int?         @map("battery_percent")
  rssi                   Int?
  firmwareVersion        String?      @map("firmware_version")
  /// Connected and heard from within 3 heartbeats (pagers); kept current by the pager service.
  online                 Boolean      @default(false)
  staff                  Staff?       @relation(fields: [staffId], references: [id])
  sessions               Session[]
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, status])
  @@index([restaurantId, serial])
  @@map("devices")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  restaurantId      String    @map("restaurant_id") @db.Uuid
  staffId           String    @map("staff_id") @db.Uuid
  staff             Staff     @relation(fields: [staffId], references: [id])
  deviceId          String    @map("device_id") @db.Uuid
  device            Device    @relation(fields: [deviceId], references: [id])
  /// SHA-256 of the current refresh token; the token itself is never stored.
  tokenHash         String    @unique @map("token_hash")
  /// SHA-256 of the refresh token this one replaced; presenting it again revokes the session.
  previousTokenHash String?   @unique @map("previous_token_hash")
  /// When the Owner last confirmed password + second factor in this session (AUTH-006 step-up).
  secondFactorAt    DateTime? @map("second_factor_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([staffId])
  @@map("sessions")
}

/// One-time Owner recovery codes, usable instead of a TOTP code (AUTH-006).
model RecoveryCode {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  staff        Staff     @relation(fields: [staffId], references: [id])
  /// SHA-256 of the code; codes are random, so a fast hash is enough.
  codeHash     String    @unique @map("code_hash")
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([staffId])
  @@map("recovery_codes")
}

/// A manager's single-use approval of one action on one device (AUTH-011).
model OverrideGrant {
  id                 String    @id @default(uuid(7)) @db.Uuid
  restaurantId       String    @map("restaurant_id") @db.Uuid
  deviceId           String    @map("device_id") @db.Uuid
  requesterId        String    @map("requester_id") @db.Uuid
  requesterSessionId String    @map("requester_session_id") @db.Uuid
  approverId         String    @map("approver_id") @db.Uuid
  capability         String
  entityType         String?   @map("entity_type")
  entityId           String?   @map("entity_id") @db.Uuid
  /// SHA-256 of the override token; the token itself is never stored.
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("override_grants")
}

/// A manager's one-time code for pairing one device (AUTH-007).
model PairingCode {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  /// SHA-256 of the code; the code itself is shown once and never stored.
  codeHash     String     @unique @map("code_hash")
  type         DeviceType
  name         String
  tableId      String?    @map("table_id") @db.Uuid
  stationId    String?    @map("station_id") @db.Uuid
  staffId      String?    @map("staff_id") @db.Uuid
  /// Manager who created the code; null for the installer's bootstrap code.
  createdById  String?    @map("created_by_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?  @map("used_at") @db.Timestamptz(3)
  deviceId     String?    @map("device_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([expiresAt])
  @@map("pairing_codes")
}

// ---------------------------------------------------------------- floor

model Section {
  id           String            @id @default(uuid(7)) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  name         String
  displayOrder Int               @default(0) @map("display_order")
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)
  tables       DiningTable[]
  assignments  ShiftAssignment[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("sections")
}

model DiningTable {
  id           String            @id @default(uuid(7)) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  sectionId    String            @map("section_id") @db.Uuid
  section      Section           @relation(fields: [sectionId], references: [id])
  /// Number or name shown to staff and on KOTs, e.g. "12" or "Terrace 3".
  label        String
  capacity     Int               @default(4)
  state        TableState        @default(FREE)
  /// Position on the visual floor plan (S requirement), free-form.
  layout       Json?
  displayOrder Int               @default(0) @map("display_order")
  externalId   String?           @map("external_id")
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)
  sessions     TableSession[]
  devices      Device[]
  orders       Order[]
  assignments  ShiftAssignment[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@map("tables")
}

model TableSession {
  id                 String             @id @default(uuid(7)) @db.Uuid
  restaurantId       String             @map("restaurant_id") @db.Uuid
  tableId            String             @map("table_id") @db.Uuid
  table              DiningTable        @relation(fields: [tableId], references: [id])
  businessDate       DateTime           @map("business_date") @db.Date
  status             TableSessionStatus @default(OPEN)
  covers             Int?
  waiterId           String?            @map("waiter_id") @db.Uuid
  openedAt           DateTime           @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(3)
  closeReason        String?            @map("close_reason")
  /// Set when guests moved here from another table (TBL-006).
  movedFromSessionId String?            @map("moved_from_session_id") @db.Uuid
  orders             Order[]
  invoices           Invoice[]
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  bill               Bill?

  @@index([restaurantId, businessDate])
  @@index([tableId, status])
  @@map("table_sessions")
}

/// A waiter's assignment for a business day (TBL-002): a whole section, or one table of it.
model ShiftAssignment {
  id           String       @id @default(uuid(7)) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  staffId      String       @map("staff_id") @db.Uuid
  staff        Staff        @relation(fields: [staffId], references: [id])
  sectionId    String       @map("section_id") @db.Uuid
  section      Section      @relation(fields: [sectionId], references: [id])
  /// Set when the waiter is given this one table rather than the whole section (P1-02a).
  tableId      String?      @map("table_id") @db.Uuid
  table        DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  businessDate DateTime     @map("business_date") @db.Date
  startsAt     DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?    @map("ends_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@map("shift_assignments")
}

// ---------------------------------------------------------------- menu

model Category {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  parentId     String?    @map("parent_id") @db.Uuid
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  name         String
  displayOrder Int        @default(0) @map("display_order")
  externalId   String?    @map("external_id")
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  items        Item[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("categories")
}

model Printer {
  id             String            @id @default(uuid(7)) @db.Uuid
  restaurantId   String            @map("restaurant_id") @db.Uuid
  name           String
  connection     PrinterConnection
  host           String?
  port           Int?
  paperWidthMm   Int               @default(80) @map("paper_width_mm")
  lastSeenAt     DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  /// Set when a job failed; cleared when the printer takes one again (KDS-008, NTF-003).
  offlineSince   DateTime?         @map("offline_since") @db.Timestamptz(3)
  lastError      String?           @map("last_error")
  /// While set, this printer's jobs go to that printer instead (KDS-008 redirect).
  redirectToId   String?           @map("redirect_to_id") @db.Uuid
  redirectTo     Printer?          @relation("PrinterRedirect", fields: [redirectToId], references: [id])
  redirectedFrom Printer[]         @relation("PrinterRedirect")
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(3)
  stations       Station[]
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("printers")
}

model Station {
  id           String        @id @default(uuid(7)) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  name         String
  mode         StationMode   @default(BOTH)
  printerId    String?       @map("printer_id") @db.Uuid
  printer      Printer?      @relation(fields: [printerId], references: [id])
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(3)
  items        Item[]
  kots         Kot[]
