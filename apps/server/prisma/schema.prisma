// Restaurant Operations Platform: local database schema.
// Conventions (docs/build/CONVENTIONS.md, ADR-0005): UUIDv7 ids generated by the client,
// restaurant_id on every table, snake_case table and column names, money as integer paise.
// P0-08 core data model (docs/build/phases/phase-0.md):
// - every table has id (UUIDv7), restaurant_id, created_at, updated_at; restaurant_id is an indexed
//   column without a foreign key because the local database holds exactly one restaurant (SEC-005);
// - business records carry business_date (DATE, cut-off 04:00 IST by default);
// - money is Int paise (BigInt for day and shift aggregates), rates are Int basis points;
// - financial and audit tables are protected by roles and triggers in the P0-08 migration (AUD-004);
// - master data is archived (archived_at), never deleted.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums (mirror @rp/domain)

/// Built-in roles (@rp/domain ROLES).
enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum CredentialKind {
  PIN
  PASSWORD
  TOTP
}

enum DeviceType {
  POS
  KDS
  WAITER_PHONE
  TABLE_TABLET
  PAGER
  MANAGER_BROWSER
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

/// @rp/domain TABLE_STATES.
enum TableState {
  FREE
  OCCUPIED
  BILL_REQUESTED
  BILL_PRINTED
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum StationMode {
  SCREEN
  PRINT
  BOTH
}

enum PrinterConnection {
  NETWORK
  USB
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum SalesChannel {
  POS
  WAITER_APP
  TABLE_TABLET
  QR
}

enum PriceMode {
  TAX_EXCLUSIVE
  TAX_INCLUSIVE
}

enum ComboComponentKind {
  FIXED
  CHOICE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

/// @rp/domain ORDER_SOURCES.
enum OrderSource {
  POS
  WAITER_APP
  TABLE_TABLET
  QR
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// @rp/domain ORDER_ITEM_STATES.
enum OrderItemState {
  PENDING_APPROVAL
  SENT
  PREPARING
  READY
  PICKED_UP
  SERVED
  REJECTED
  CANCELLED
  VOIDED
}

enum KotKind {
  NEW
  MODIFIED
  CANCELLED
}

enum KotPrintStatus {
  NOT_REQUIRED
  PENDING
  PRINTED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  ISSUED
  SETTLED
  VOIDED
}

enum DiscountKind {
  PERCENT
  FLAT
}

enum PaymentMode {
  CASH
  CARD
  UPI
  OTHER
}

enum PaymentStatus {
  CAPTURED
  REFUNDED
  VOIDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashDirection {
  IN
  OUT
}

/// Per-business-day human numbers (ADR-0005).
enum CounterKind {
  ORDER
  KOT
  TAKEAWAY_TOKEN
}

// ---------------------------------------------------------------- restaurant and system

/// The restaurant this installation serves. The local database holds exactly one (SEC-005),
/// but every record still carries restaurant_id for consistency with the cloud.
model Restaurant {
  id                String    @id @default(uuid(7)) @db.Uuid
  legalName         String?   @map("legal_name")
  displayName       String    @map("display_name")
  gstin             String?
  fssaiNumber       String?   @map("fssai_number")
  /// GST state code (two digits) of the place of supply.
  stateCode         String?   @map("state_code")
  address           Json?
  timeZone          String    @default("Asia/Kolkata") @map("time_zone")
  /// Business-day cut-off, local time HH:MM (default 04:00).
  businessDayCutoff String    @default("04:00") @map("business_day_cutoff")
  priceMode         PriceMode @default(TAX_EXCLUSIVE) @map("price_mode")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("restaurants")
}

/// Installation-level key/value facts (schema version markers, installation id).
model SystemMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_meta")
}

model Setting {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Settings-registry key (P1-01), e.g. "billing.serviceCharge.enabled".
  key          String
  value        Json
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("settings")
}

model BusinessDay {
  id           String            @id @default(uuid(7)) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  businessDate DateTime          @map("business_date") @db.Date
  status       BusinessDayStatus @default(OPEN)
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById   String?           @map("closed_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId])
  @@map("business_days")
}

model DailyCounter {
  id           String      @id @default(uuid(7)) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  businessDate DateTime    @map("business_date") @db.Date
  kind         CounterKind
  /// Last number handed out; the next is allocated with a row lock inside the caller's transaction.
  lastValue    Int         @default(0) @map("last_value")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, businessDate, kind])
  @@index([restaurantId])
  @@map("daily_counters")
}

// ---------------------------------------------------------------- staff, access, devices

model Role {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  /// Stable key, e.g. "MANAGER"; custom roles (later) get their own keys.
  key          String
  name         String
  baseRole     StaffRole @map("base_role")
  builtIn      Boolean   @default(true) @map("built_in")
  /// Extra capabilities granted on top of the base role (custom roles, later WPs).
  capabilities String[]  @default([])
  staff        Staff[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("roles")
}

model Staff {
  id               String            @id @default(uuid(7)) @db.Uuid
  restaurantId     String            @map("restaurant_id") @db.Uuid
  roleId           String            @map("role_id") @db.Uuid
  role             Role              @relation(fields: [roleId], references: [id])
  displayName      String            @map("display_name")
  photoId          String?           @map("photo_id") @db.Uuid
  phone            String?
  email            String?
  active           Boolean           @default(true)
  externalId       String?           @map("external_id")
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  credentials      Credential[]
  sessions         Session[]
  shiftAssignments ShiftAssignment[]
  shifts           Shift[]
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, active])
  @@map("staff")
}

model Credential {
  id             String         @id @default(uuid(7)) @db.Uuid
  restaurantId   String         @map("restaurant_id") @db.Uuid
  staffId        String         @map("staff_id") @db.Uuid
  staff          Staff          @relation(fields: [staffId], references: [id])
  kind           CredentialKind
  /// bcrypt/Argon2id hash of PIN + pepper, or password hash, or encrypted TOTP secret (AUTH-002).
  secretHash     String         @map("secret_hash")
  failedAttempts Int            @default(0) @map("failed_attempts")
  lockedUntil    DateTime?      @map("locked_until") @db.Timestamptz(3)
  rotatedAt      DateTime       @default(now()) @map("rotated_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([staffId, kind])
  @@index([restaurantId])
  @@map("credentials")
}

model Device {
  id                     String       @id @default(uuid(7)) @db.Uuid
  restaurantId           String       @map("restaurant_id") @db.Uuid
  type                   DeviceType
  name                   String
  status                 DeviceStatus @default(PENDING)
  /// Device public key (PEM) or certificate fingerprint issued at pairing (AUTH-007).
  publicKey              String?      @map("public_key")
  certificateFingerprint String?      @map("certificate_fingerprint")
  pairedAt               DateTime?    @map("paired_at") @db.Timestamptz(3)
  pairedById             String?      @map("paired_by_id") @db.Uuid
  revokedAt              DateTime?    @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt             DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  appVersion             String?      @map("app_version")
  /// Table a table tablet is bound to (AUTH-009).
  tableId                String?      @map("table_id") @db.Uuid
  table                  DiningTable? @relation(fields: [tableId], references: [id])
  sessions               Session[]
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, status])
  @@map("devices")
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  staff        Staff     @relation(fields: [staffId], references: [id])
  deviceId     String    @map("device_id") @db.Uuid
  device       Device    @relation(fields: [deviceId], references: [id])
  /// SHA-256 of the session token; the token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([staffId])
  @@map("sessions")
}

// ---------------------------------------------------------------- floor

model Section {
  id           String            @id @default(uuid(7)) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  name         String
  displayOrder Int               @default(0) @map("display_order")
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)
  tables       DiningTable[]
  assignments  ShiftAssignment[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("sections")
}

model DiningTable {
  id           String         @id @default(uuid(7)) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  sectionId    String         @map("section_id") @db.Uuid
  section      Section        @relation(fields: [sectionId], references: [id])
  /// Number or name shown to staff and on KOTs, e.g. "12" or "Terrace 3".
  label        String
  capacity     Int            @default(4)
  state        TableState     @default(FREE)
  /// Position on the visual floor plan (S requirement), free-form.
  layout       Json?
  displayOrder Int            @default(0) @map("display_order")
  externalId   String?        @map("external_id")
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz(3)
  sessions     TableSession[]
  devices      Device[]
  orders       Order[]
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([restaurantId, label])
  @@index([restaurantId])
  @@map("tables")
}

model TableSession {
  id                 String             @id @default(uuid(7)) @db.Uuid
  restaurantId       String             @map("restaurant_id") @db.Uuid
  tableId            String             @map("table_id") @db.Uuid
  table              DiningTable        @relation(fields: [tableId], references: [id])
  businessDate       DateTime           @map("business_date") @db.Date
  status             TableSessionStatus @default(OPEN)
  covers             Int?
  waiterId           String?            @map("waiter_id") @db.Uuid
  openedAt           DateTime           @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(3)
  closeReason        String?            @map("close_reason")
  /// Set when guests moved here from another table (TBL-006).
  movedFromSessionId String?            @map("moved_from_session_id") @db.Uuid
  orders             Order[]
  invoices           Invoice[]
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@index([tableId, status])
  @@map("table_sessions")
}

model ShiftAssignment {
  id           String    @id @default(uuid(7)) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  staff        Staff     @relation(fields: [staffId], references: [id])
  sectionId    String    @map("section_id") @db.Uuid
  section      Section   @relation(fields: [sectionId], references: [id])
  businessDate DateTime  @map("business_date") @db.Date
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, businessDate])
  @@map("shift_assignments")
}

// ---------------------------------------------------------------- menu

model Category {
  id           String     @id @default(uuid(7)) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  parentId     String?    @map("parent_id") @db.Uuid
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  name         String
  displayOrder Int        @default(0) @map("display_order")
  externalId   String?    @map("external_id")
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  items        Item[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("categories")
}

model Printer {
  id           String            @id @default(uuid(7)) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  name         String
  connection   PrinterConnection
  host         String?
  port         Int?
  paperWidthMm Int               @default(80) @map("paper_width_mm")
  lastSeenAt   DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)
  stations     Station[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("printers")
}

model Station {
  id           String      @id @default(uuid(7)) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  name         String
  mode         StationMode @default(BOTH)
  printerId    String?     @map("printer_id") @db.Uuid
  printer      Printer?    @relation(fields: [printerId], references: [id])
  archivedAt   DateTime?   @map("archived_at") @db.Timestamptz(3)
  items        Item[]
  kots         Kot[]
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("stations")
}

model TaxGroup {
  id           String         @id @default(uuid(7)) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  /// e.g. "GST 5 %". Rates are data, never constants in code (BILL-004).
  name         String
  /// SAC/HSN code printed on invoices.
  sacCode      String?        @map("sac_code")
  archivedAt   DateTime?      @map("archived_at") @db.Timestamptz(3)
  components   TaxComponent[]
  items        Item[]
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("tax_groups")
}

model TaxComponent {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  taxGroupId   String   @map("tax_group_id") @db.Uuid
  taxGroup     TaxGroup @relation(fields: [taxGroupId], references: [id])
  /// e.g. "CGST", "SGST", "IGST".
  code         String
  rateBp       Int      @map("rate_bp")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([taxGroupId, code])
  @@index([restaurantId])
  @@map("tax_components")
}

model Photo {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// Path relative to the photo store (P1-04); images are re-encoded on upload.
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  width        Int
  height       Int
  bytes        Int
  sha256       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("photos")
}

model Item {
  id              String              @id @default(uuid(7)) @db.Uuid
  restaurantId    String              @map("restaurant_id") @db.Uuid
  categoryId      String              @map("category_id") @db.Uuid
  category        Category            @relation(fields: [categoryId], references: [id])
  name            String
  shortCode       String?             @map("short_code")
  description     String?
  photoId         String?             @map("photo_id") @db.Uuid
  basePrice       Int                 @map("base_price")
  taxGroupId      String              @map("tax_group_id") @db.Uuid
  taxGroup        TaxGroup            @relation(fields: [taxGroupId], references: [id])
  foodType        FoodType            @map("food_type")
  spiceLevel      Int                 @default(0) @map("spice_level")
  stationId       String              @map("station_id") @db.Uuid
  station         Station             @relation(fields: [stationId], references: [id])
  prepTimeMinutes Int?                @map("prep_time_minutes")
  available       Boolean             @default(true)
  /// Counts stock in stock_levels when true (MENU-006).
  trackStock      Boolean             @default(false) @map("track_stock")
  displayOrder    Int                 @default(0) @map("display_order")
  channels        SalesChannel[]      @default([POS, WAITER_APP, TABLE_TABLET, QR])
  repeatable      Boolean             @default(false)
  externalId      String?             @map("external_id")
  archivedAt      DateTime?           @map("archived_at") @db.Timestamptz(3)
  variants        Variant[]
  modifierGroups  ItemModifierGroup[]
  combo           Combo?
  comboComponents ComboComponent[]
  comboChoices    ComboChoiceOption[]
  tags            ItemTag[]
  synonyms        Synonym[]
  stockLevel      StockLevel?
  orderItems      OrderItem[]
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId, categoryId])
  @@index([restaurantId, externalId])
  @@map("items")
}

model Variant {
  id           String      @id @default(uuid(7)) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  itemId       String      @map("item_id") @db.Uuid
  item         Item        @relation(fields: [itemId], references: [id])
  name         String
  price        Int
  displayOrder Int         @default(0) @map("display_order")
  externalId   String?     @map("external_id")
  archivedAt   DateTime?   @map("archived_at") @db.Timestamptz(3)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([itemId])
  @@map("variants")
}

model ModifierGroup {
  id            String              @id @default(uuid(7)) @db.Uuid
  restaurantId  String              @map("restaurant_id") @db.Uuid
  name          String
  minSelections Int                 @default(0) @map("min_selections")
  maxSelections Int                 @default(1) @map("max_selections")
  archivedAt    DateTime?           @map("archived_at") @db.Timestamptz(3)
  options       ModifierOption[]
  items         ItemModifierGroup[]
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@map("modifier_groups")
}

model ModifierOption {
  id                 String              @id @default(uuid(7)) @db.Uuid
  restaurantId       String              @map("restaurant_id") @db.Uuid
  groupId            String              @map("group_id") @db.Uuid
  group              ModifierGroup       @relation(fields: [groupId], references: [id])
  name               String
  /// Signed price change in paise (may be negative).
  priceDelta         Int                 @default(0) @map("price_delta")
  available          Boolean             @default(true)
  displayOrder       Int                 @default(0) @map("display_order")
  archivedAt         DateTime?           @map("archived_at") @db.Timestamptz(3)
  orderItemModifiers OrderItemModifier[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([restaurantId])
  @@index([groupId])
  @@map("modifier_options")
}

model ItemModifierGroup {
