// Restaurant Operations Platform: local database schema.
// Conventions (docs/build/CONVENTIONS.md, ADR-0005): UUIDv7 ids generated by the client,
// restaurant_id on every table, snake_case table and column names, money as integer paise.
// P0-08 adds the core data model; this file starts with the minimum the skeleton needs.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// The restaurant this installation serves. The local database holds exactly one (SEC-005),
/// but every record still carries restaurant_id for consistency with the cloud.
model Restaurant {
  id          String   @id @default(uuid(7)) @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("restaurants")
}

/// Installation-level key/value facts (schema version markers, installation id).
model SystemMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_meta")
}
