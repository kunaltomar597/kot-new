# Local server configuration (copy to .env for development). Never commit real secrets (SEC-002).
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# PostgreSQL on this PC only (DATA-001).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/rp_dev
# Folder for photos, backups and other files (ONB-002 data drive).
RP_DATA_DIR=./.data
# Built web console to serve at / (apps/console/dist after `pnpm build`); leave unset for API only.
# RP_CONSOLE_DIR=../console/dist
# HTTPS/WSS with the installation's own CA (P0-15, ADR-0011); on for the restaurant PC. Extra names
# for the server certificate, comma-separated (its LAN addresses and computer name are automatic).
# RP_TLS=on
# RP_TLS_HOSTNAMES=pos.local
LOG_LEVEL=info
LOG_PRETTY=true
# Shadow database for `prisma migrate diff --from-migrations` (development only).
# SHADOW_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/rp_shadow
