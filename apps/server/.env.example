# Local server configuration (copy to .env for development). Never commit real secrets (SEC-002).
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# PostgreSQL on this PC only (DATA-001).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/rp_dev
# Folder for photos, backups and other files (ONB-002 data drive).
RP_DATA_DIR=./.data
# Built web console to serve at / (apps/console/dist after `pnpm build`); leave unset for API only.
# RP_CONSOLE_DIR=../console/dist
# The release's phone and tablet APKs with their apps.json (P7-04e2); unset, the PC offers none.
# RP_APPS_DIR=
# HTTPS/WSS with the installation's own CA (P0-15, ADR-0011); on for the restaurant PC. Extra names
# for the server certificate, comma-separated (its LAN addresses and computer name are automatic).
# RP_TLS=on
# RP_TLS_HOSTNAMES=pos.local
# Pager broker (P2-04): MQTTS on 8883 by default; RP_MQTT=off turns it off.
# RP_MQTT_PORT=8883
# Vendor Control Plane (P0-17, ADR-0012): the service's origin, https:// in production. Unset: no
# cloud calls. Enrol this PC once with `pnpm control-plane:enrol <code from the vendor>`.
# RP_CONTROL_PLANE_URL=https://control-plane.example.com
# The QR relay's functions (ADR-0015); unset means no QR menu sync. Store its credential with
# `pnpm relay:credential` (it is sealed in the database, never kept here).
# RP_RELAY_URL=https://<project-ref>.supabase.co/functions/v1
# The public QR menu site; table QR codes open <site>/t/<token> (P5-04, P5-05).
# RP_QR_SITE_URL=https://menu.example.in
# Version of the installed product, set by the installer (P0-16); the server's version otherwise.
# RP_PRODUCT_VERSION=1.0.0
# The vendor's error service, a Sentry DSN (NFR-O02); set by the installer. Unset: no reports.
# RP_ERROR_DSN=https://<public key>@<host>/<project id>
# Backups (P7-05): the PostgreSQL client programs (pg_dump, pg_restore), found on the PATH when
# unset; the installer sets them. RP_BACKUPS=off turns the nightly backup off (not in production).
# RP_PG_BIN=C:\Program Files\PostgreSQL\16\bin
# RP_BACKUPS=on
# The restore tool's administrator connection (P7-05b; the Windows service's, not the server's),
# and the continuous backup's REPLICATION role (P7-05c). Unset: no continuous backup.
# RP_ADMIN_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres
# RP_BACKUP_DATABASE_URL=postgresql://rp_backup:<password>@localhost:5432/postgres
# The archive-then-purge login (P7-06b), a member of rp_purge only. Unset: no year is purged.
# RP_PURGE_DATABASE_URL=postgresql://rp_purger:<password>@localhost:5432/restaurant
# Where the local secrets are kept (SEC-006): file under RP_DATA_DIR/secrets for development;
# dpapi (Windows DPAPI) on the restaurant PC, where the installer sets it (P0-16b).
# RP_SECRET_STORE=file
LOG_LEVEL=info
LOG_PRETTY=true
# Shadow database for `prisma migrate diff --from-migrations` (development only).
# SHADOW_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/rp_shadow
# Licence (LIC-003, P7-01c). Production always applies it, against the vendor keys built into the
# software only; elsewhere it is shown but restricts nothing unless RP_LICENCE_ENFORCE=true.
# RP_LICENCE_ENFORCE=false
# Extra vendor public keys (SPKI DER, base64, comma-separated) for development and tests only.
# RP_LICENCE_KEYS=
# Pager firmware (PGR-011, P2-04b): extra secure boot key digests (espsecure
# digest-sbv2-public-key, hex, comma-separated) for development and tests only; production trusts
# only the keys built into the software.
# RP_PAGER_FIRMWARE_KEYS=
# Software updates (UPD-007, P7-04c): the Authenticode signer update installers must carry (the
# vendor's code-signing certificate's subject). The installer sets it on the restaurant PC; without
# it updates are refused, unless RP_UPDATE_ALLOW_UNSIGNED=on (test builds only).
# RP_UPDATE_PUBLISHER=
# And the issuer of that certificate (UPDATE-S2): a certificate with the same name from another
# authority is refused.
# RP_UPDATE_ISSUER=
# RP_UPDATE_ALLOW_UNSIGNED=off
