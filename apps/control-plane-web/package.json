{
  "name": "@rp/control-plane-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for vendor staff (VCP-001): restaurants, licences, billing, releases, audit and staff accounts, on the Vendor Control Plane's API (P7-02e).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "clean": "rm -rf dist coverage test-results playwright-report"
  },
  "dependencies": {
    "@rp/contracts": "workspace:*",
    "@rp/design-tokens": "workspace:*",
    "@rp/domain": "workspace:*",
    "@rp/i18n": "workspace:*",
    "@rp/ui-web": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rp/test-postgres": "workspace:*",
    "@rp/totp": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4"
  }
}
