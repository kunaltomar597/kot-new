{
  "name": "@rp/qr-menu",
  "version": "0.1.0",
  "private": true,
  "description": "QR online menu (C7): the public, mobile-first site a table's QR code opens; reads the menu and sends dine-in orders through the QR relay's functions (QR-002, QR-006).",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "e2e": "playwright test",
    "clean": "rm -rf .next coverage test-results playwright-report"
  },
  "dependencies": {
    "@rp/contracts": "workspace:*",
    "@rp/design-tokens": "workspace:*",
    "@rp/domain": "workspace:*",
    "@rp/i18n": "workspace:*",
    "@rp/ordering": "workspace:*",
    "@rp/ui-web": "workspace:*",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rp/relay": "workspace:*",
    "@rp/test-postgres": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1"
  }
}
