{
  "name": "@rp/console",
  "version": "0.1.0",
  "private": true,
  "description": "Web console (C3): POS, KDS and manager dashboard modes, served by the local server (MGR-001, KDS-001).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "clean": "rm -rf dist coverage test-results playwright-report"
  },
  "dependencies": {
    "@rp/api-client": "workspace:*",
    "@rp/contracts": "workspace:*",
    "@rp/design-tokens": "workspace:*",
    "@rp/domain": "workspace:*",
    "@rp/i18n": "workspace:*",
    "@rp/ui-web": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "pg": "^8.23.0",
    "vite": "^8.3.1"
  }
}
