// Vendor Control Plane database (ADR-0012). Conventions follow the local server (ADR-0005):
// UUIDv7 ids generated by the service, snake_case tables and columns, instants in UTC.
// P0-17a: tenants, installations with their public keys, heartbeats, request nonces, releases
// and the audit log. Vendor staff accounts, licences and subscriptions come in P7-01 and P7-02.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// An enrolled installation's lifecycle: created with a code (PENDING), enrolled (ACTIVE), or
/// disconnected by the vendor (REVOKED).
enum InstallationStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// @rp/contracts/control-plane RELEASE_CHANNELS (UPD-002).
enum ReleaseChannel {
  STABLE
  PILOT
}

/// @rp/contracts/control-plane RELEASE_COMPONENTS.
enum ReleaseComponent {
  RESTAURANT_PC
}

/// The licence states of LIC-005 (`@rp/domain` `licenseMachine`).
enum LicenceState {
  ACTIVE
  PAYMENT_DUE
  GRACE
  RESTRICTED
  TERMINATED
}

/// Vendor staff roles (VCP-001): `@rp/contracts/control-plane` VENDOR_ROLES.
enum VendorRole {
  SUPER_ADMIN
  ONBOARDING
  SUPPORT
  FINANCE
  READ_ONLY
}

/// A vendor staff account (VCP-001, SEC-018): password and authenticator, both mandatory.
model VendorUser {
  id             String     @id @db.Uuid
  /// Lower case.
  email          String     @unique
  name           String
  role           VendorRole
  /// Argon2id, peppered with the Control Plane's secret key; null until set up.
  passwordHash   String?    @map("password_hash")
  /// The authenticator's secret, sealed with the Control Plane's secret key.
  totpSecret     String?    @map("totp_secret")
  /// The last authenticator step used: a code is never accepted twice.
  totpLastStep   Int?       @map("totp_last_step")
  /// Set when the authenticator was confirmed: only then can the account sign in.
  activatedAt    DateTime?  @map("activated_at") @db.Timestamptz(3)
  /// SHA-256 of the one-time setup token (a new account, or a reset).
  setupTokenHash String?    @unique @map("setup_token_hash")
  setupExpiresAt DateTime?  @map("setup_expires_at") @db.Timestamptz(3)
  failedSignIns  Int        @default(0) @map("failed_sign_ins")
  lockedUntil    DateTime?  @map("locked_until") @db.Timestamptz(3)
  disabledAt     DateTime?  @map("disabled_at") @db.Timestamptz(3)
  lastSignInAt   DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  /// The last quarterly access review that kept the account (SEC-018).
  reviewedAt     DateTime?  @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions VendorSession[]

  @@map("vendor_users")
}

/// A signed-in vendor staff member: the bearer token is kept only as its SHA-256.
model VendorSession {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)
  address    String?

  user VendorUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("vendor_sessions")
}

/// A restaurant business, the vendor's customer (VCP-002 grows it in P7-02).
model Tenant {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installations   Installation[]
  menuExtractions MenuExtraction[]

  @@map("tenants")
}

/// One restaurant PC running the local server.
model Installation {
  id                     String             @id @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  name                   String
  status                 InstallationStatus @default(PENDING)
  channel                ReleaseChannel     @default(STABLE)
  /// Ed25519 public key, SPKI DER in base64; set at enrolment.
  publicKey              String?            @map("public_key")
  /// SHA-256 (hex) of the one-time enrolment code while one is outstanding.
  enrolmentCodeHash      String?            @unique @map("enrolment_code_hash")
  enrolmentCodeExpiresAt DateTime?          @map("enrolment_code_expires_at") @db.Timestamptz(3)
  enrolledAt             DateTime?          @map("enrolled_at") @db.Timestamptz(3)
  revokedAt              DateTime?          @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt             DateTime?          @map("last_seen_at") @db.Timestamptz(3)
  /// The latest heartbeat's payload, for fleet views (VCP-005, P7-03).
  lastHeartbeat          Json?              @map("last_heartbeat")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  heartbeats      Heartbeat[]
  nonces          RequestNonce[]
  menuExtractions MenuExtraction[]
  licence         InstallationLicence?
  licenceFiles    LicenceFile[]

  @@index([tenantId])
  @@map("installations")
}

/// An installation's licence terms (LIC-001, VCP-003); every file issued from them is a LicenceFile.
model InstallationLicence {
  installationId      String       @id @map("installation_id") @db.Uuid
  plan                String
  /// LicenceModule codes.
  modules             String[]
  /// DeviceLimits: { TABLE_TABLET, PAGER, WAITER_PHONE, KDS }.
  deviceLimits        Json         @map("device_limits")
  validityDays        Int          @map("validity_days")
  graceDays           Int          @map("grace_days")
  state               LicenceState @default(ACTIVE)
  graceStartedAt      DateTime?    @map("grace_started_at") @db.Timestamptz(3)
  reason              String?
  /// The PC fingerprint bound at the first licence (LIC-004): five SHA-256 hex strings or nulls.
  fingerprint         Json?
  boundAt             DateTime?    @map("bound_at") @db.Timestamptz(3)
  /// Bumped on every change of terms, so the next heartbeat carries a new file at once.
  revision            Int          @default(1)
  /// The last offline reactivation code's counter (LIC-006).
  reactivationCounter Int          @default(0) @map("reactivation_counter")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  installation Installation @relation(fields: [installationId], references: [id])

  @@map("installation_licences")
}

/// Every licence file issued (LIC-001): the exact text signed, kept for support and audit.
model LicenceFile {
  id             String   @id @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  /// The terms' revision it was issued from.
  revision       Int
  state          LicenceState
  issuedAt       DateTime @map("issued_at") @db.Timestamptz(3)
  validUntil     DateTime @map("valid_until") @db.Timestamptz(3)
  payload        String
  signature      String
  keyId          String   @map("key_id")

  installation Installation @relation(fields: [installationId], references: [id])

  @@index([installationId, issuedAt])
  @@map("licence_files")
}

/// Every heartbeat an installation sent (VCP-005). Retention and fleet views come in P7-03.
model Heartbeat {
  installationId String   @map("installation_id") @db.Uuid
  /// Chosen by the installation, so a retried heartbeat is stored once.
  id             String   @db.Uuid
  sentAt         DateTime @map("sent_at") @db.Timestamptz(3)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  payload        Json

  installation Installation @relation(fields: [installationId], references: [id])

  @@id([installationId, id])
  @@index([installationId, receivedAt])
  @@map("heartbeats")
}

/// Nonces of signed requests, each accepted once per installation until it expires (ADR-0012).
model RequestNonce {
  installationId String   @map("installation_id") @db.Uuid
  nonce          String
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  installation Installation @relation(fields: [installationId], references: [id])

  @@id([installationId, nonce])
  @@index([expiresAt])
  @@map("request_nonces")
}

/// A published build on a channel (UPD-002). Rollouts, pinning and halts come in P7-04.
model Release {
  id          String           @id @db.Uuid
  component   ReleaseComponent
  channel     ReleaseChannel
  version     String
  url         String
  sha256      String
  sizeBytes   BigInt           @map("size_bytes")
  notes       String?
  publishedAt DateTime         @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy String           @map("published_by")

  @@unique([component, channel, version])
  @@map("releases")
}

/// Every vendor or installation action (VCP-001: every action is audited). Append-only: a
/// trigger refuses updates and deletes.
model AuditEntry {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// `cli:<user>`, `ci:<pipeline>` or `installation:<id>`.
  actor      String
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?

  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Where reading a printed menu stands (ONB-006, P6-04a).
enum MenuExtractionStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// One AI-assisted menu import (ONB-006, VCP-008): the job, what it cost and the draft it read.
/// The files are kept only until they are read; the draft is purged after 30 days.
model MenuExtraction {
  id             String               @id @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  installationId String               @map("installation_id") @db.Uuid
  status         MenuExtractionStatus @default(QUEUED)
  files          Int
  bytes          Int
  draft          Json?
  errorCode      String?              @map("error_code")
  errorMessage   String?              @map("error_message")
  model          String?
  inputTokens    Int?                 @map("input_tokens")
  outputTokens   Int?                 @map("output_tokens")
  attempts       Int                  @default(0)
  /// A busy provider is tried again no sooner than this.
  notBefore      DateTime?            @map("not_before") @db.Timestamptz(3)
  startedAt      DateTime?            @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?            @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  installation Installation         @relation(fields: [installationId], references: [id])
  uploads      MenuExtractionFile[]

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("menu_extractions")
}

/// A photo or PDF waiting to be read; deleted once its extraction is done or failed.
model MenuExtractionFile {
  id           String   @id @db.Uuid
  extractionId String   @map("extraction_id") @db.Uuid
  position     Int
  name         String
  contentType  String   @map("content_type")
  content      Bytes
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  extraction MenuExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@unique([extractionId, position])
  @@map("menu_extraction_files")
}
