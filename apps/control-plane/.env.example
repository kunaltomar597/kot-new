# Vendor Control Plane configuration (copy to .env for development). Never commit real secrets
# (SEC-002): staging and production get these from the hosting provider's secret manager.
CP_ENV=development
HOST=0.0.0.0
PORT=8090
# PostgreSQL in an India region for staging and production (VCP-009); they need sslmode=require.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cp_dev
LOG_LEVEL=info
LOG_PRETTY=true
# Seconds between heartbeats asked of every installation (VCP-005, default 300).
# CP_HEARTBEAT_SECONDS=300
# Reverse proxies in front of the service (the load balancer), for client addresses.
# CP_TRUST_PROXY=1
# Requests one client address may make at once and then per second (0 burst: off); digital bill
# pages have limits of their own (CP-D1).
# CP_REQUEST_BURST=300
# CP_REQUESTS_PER_SECOND=30
# CP_PUBLIC_REQUEST_BURST=60
# CP_PUBLIC_REQUESTS_PER_SECOND=5
# Who the admin CLI records as the actor (defaults to cli:<operating-system user>).
# CP_ACTOR=ci:release-pipeline
# Shadow database for `prisma migrate diff --from-migrations` (development only).
# SHADOW_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cp_shadow
# AI-assisted menu import (ONB-006). The key comes from the secret manager only, never a file in
# the repository (SEC-002); without it, restaurants use the Excel template.
# CP_AI_API_KEY=
# CP_AI_MODEL=claude-sonnet-5-5
# CP_AI_DAILY_LIMIT=20
# CP_AI_TIMEOUT_SECONDS=300
# Licences (LIC-001, P7-01). The signing key (Ed25519, PKCS#8 DER, base64) and the reactivation
# master secret (32 random bytes, base64) come from the secret manager only (manual task 23).
# Without the signing key no licence is issued.
# CP_LICENCE_SIGNING_KEY=
# CP_LICENCE_REACTIVATION_KEY=
# CP_LICENCE_VALIDITY_DAYS=30
# CP_LICENCE_GRACE_DAYS=7
# CP_LICENCE_HEARTBEAT_SECONDS=60
# The Control Plane's own secret (32 random bytes, base64) from the secret manager: it seals vendor
# staff's authenticator secrets and peppers their passwords. Required outside development.
# CP_SECRET_KEY=
# Subscriptions (VCP-003, LIC-005): days to pay, days past due before grace, how often billing runs.
# CP_BILLING_PAYMENT_TERMS_DAYS=7
# CP_BILLING_GRACE_AFTER_DAYS=15
# CP_BILLING_INTERVAL_MINUTES=60
# The QR relay's database for provisioning restaurants (VCP-002): its relay_control_plane login,
# which may take the relay_provisioner role only (manual task 20), from the secret manager.
# Unset: no QR provisioning from here.
# CP_RELAY_DATABASE_URL=postgresql://relay_control_plane:...@db.<project>.supabase.co:5432/postgres?sslmode=require
# The built vendor web app (VCP-001, P7-02e), served at / on the API's own origin:
# `pnpm --filter @rp/control-plane-web build`, then point this at apps/control-plane-web/dist.
# CP_WEB_DIR=../control-plane-web/dist
# Fleet monitoring (VCP-005, P7-03): minutes silent in business hours before a PC is offline,
# the disk alert threshold, how often silent PCs are looked for (0 = off), and an optional
# webhook (Slack or Teams incoming webhook) for alerts, from the secret manager.
# CP_OFFLINE_ALERT_MINUTES=30
# CP_DISK_ALERT_PERCENT=90
# CP_FLEET_SWEEP_SECONDS=60
# CP_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# The vendor's error service (NFR-O02), a Sentry DSN from the secret manager. Unset: only logs.
# CP_ERROR_DSN=https://<public key>@<host>/<project id>
# Cloud backups (DATA-003, P7-05d): where restaurant PCs upload their encrypted nightly backup.
# off (default), local (development: a folder, served by the Control Plane itself) or s3 (staging
# and production, an India region only: ap-south-1 or ap-south-2). The keys come from the secret
# manager. Retention per PC (BRD §9.3): the newest of each of the last N days and months.
# CP_BACKUP_STORE=local
# CP_BACKUP_LOCAL_DIR=./.cloud-backups
# CP_BACKUP_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# CP_BACKUP_S3_REGION=ap-south-1
# CP_BACKUP_S3_BUCKET=rp-backups-production
# CP_BACKUP_S3_ACCESS_KEY_ID=
# CP_BACKUP_S3_SECRET_ACCESS_KEY=
# CP_BACKUP_S3_PATH_STYLE=false
# CP_BACKUP_KEEP_DAILY=30
# CP_BACKUP_KEEP_MONTHLY=12
# Digital bills (BILL-012, P7-09a): the public address diners open, and the secret their links
# derive from (32 random bytes, base64), from the secret manager. WhatsApp through Meta's Cloud
# API with an approved template (manual task 28); unset: no digital bills.
# CP_PUBLIC_URL=https://cloud.example.in
# CP_DIGITAL_BILL_KEY=
# CP_DIGITAL_BILL_DAILY_LIMIT=3000
# CP_DIGITAL_BILL_SWEEP_SECONDS=3600
# CP_WHATSAPP_TOKEN=
# CP_WHATSAPP_PHONE_NUMBER_ID=
# CP_WHATSAPP_TEMPLATE=digital_bill
# CP_WHATSAPP_LANGUAGE=en
# CP_WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Staged rollouts (UPD-003): minutes of silence after a PC starts installing that count as a
# failure, server errors in the day after an install that count as a spike, and what halts a
# rollout by itself (at least this many failures, and this share of installs).
# CP_ROLLOUT_SILENT_MINUTES=45
# CP_ROLLOUT_ERROR_SPIKE=100
# CP_ROLLOUT_MIN_FAILURES=2
# CP_ROLLOUT_MAX_FAILURE_PERCENT=20
