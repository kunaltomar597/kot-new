# Vendor Control Plane configuration (copy to .env for development). Never commit real secrets
# (SEC-002): staging and production get these from the hosting provider's secret manager.
CP_ENV=development
HOST=0.0.0.0
PORT=8090
# PostgreSQL in an India region for staging and production (VCP-009); they need sslmode=require.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cp_dev
LOG_LEVEL=info
LOG_PRETTY=true
# Seconds between heartbeats asked of every installation (VCP-005, default 300).
# CP_HEARTBEAT_SECONDS=300
# Reverse proxies in front of the service (the load balancer), for client addresses.
# CP_TRUST_PROXY=1
# Who the admin CLI records as the actor (defaults to cli:<operating-system user>).
# CP_ACTOR=ci:release-pipeline
# Shadow database for `prisma migrate diff --from-migrations` (development only).
# SHADOW_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cp_shadow
