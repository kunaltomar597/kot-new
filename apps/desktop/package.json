{
  "name": "@rp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell (C4) that opens the console from the restaurant PC's own server, hardened per SEC-011 (P0-16a).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rp/i18n": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.5.1"
  }
}
