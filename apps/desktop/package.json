{
  "name": "@rp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell (C4) that opens the console from the restaurant PC's own server, hardened per SEC-011 (P0-16a), and the Windows installer (P0-16d).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package:stage": "node dist/packaging/stage-cli.js",
    "package:win": "node dist/packaging/package-cli.js",
    "clean": "rm -rf dist coverage staging release"
  },
  "dependencies": {
    "@rp/i18n": "workspace:*"
  },
  "devDependencies": {
    "@rp/contracts": "workspace:*",
    "@rp/domain": "workspace:*",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
