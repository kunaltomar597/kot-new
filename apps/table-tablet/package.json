{
  "name": "@rp/table-tablet",
  "version": "0.1.0",
  "private": true,
  "description": "Customer table tablet for Android in kiosk mode: paired to one table, live menu (C6, P2-01c).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean --no-install",
    "bundle:check": "expo export --platform android --output-dir .expo/bundle-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf coverage .expo android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rp/api-client": "workspace:*",
    "@rp/contracts": "workspace:*",
    "@rp/design-tokens": "workspace:*",
    "@rp/i18n": "workspace:*",
    "@rp/mobile-core": "workspace:*",
    "@rp/mobile-native": "workspace:*",
    "@rp/mobile-shell": "workspace:*",
    "@rp/ui-native": "workspace:*",
    "expo": "57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "babel-jest": "^30.5.2",
    "babel-preset-expo": "~57.0.13",
    "jest": "^30.5.2",
    "test-renderer": "^1.3.0"
  }
}
